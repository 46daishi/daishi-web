---
const facts = [
	{ label: 'Country', value: 'Poland' },
	{ label: 'Birthday', value: 'June 6' },
];
---

<blockquote class="profile-facts">
	{facts.map((fact) => (
		<p>
			<strong>{fact.label}:</strong> {fact.value}
		</p>
	))}
</blockquote>

<style>
	.profile-facts {
		margin: 0.55rem 0 0;
		padding: 0.25rem 0 0.25rem 0.7rem;
		border-left-width: 2px;
		color: hsl(var(--muted-foreground));
		font-family: var(--font-mono);
		font-size: 0.72rem;
		line-height: 1.55;
	}

	.profile-facts p {
		margin: 0;
	}

	.profile-facts p + p {
		margin-top: 0.15rem;
	}

	.profile-facts strong {
		color: hsl(var(--foreground));
		font-weight: 600;
	}
</style>
