---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ProjectStatus from './ProjectStatus.astro';
import SectionLink from './SectionLink.astro';

type Props = {
	projects: CollectionEntry<'projects'>[];
};

const { projects } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

{
	projects.length > 0 && (
		<section
			class="featured-projects"
			id="featured-projects"
			aria-labelledby="featured-projects-heading"
		>
			<div class="section-heading">
				<div>
					<span class="section-kicker" lang="ja">作品</span>
					<h2 id="featured-projects-heading">featured projects</h2>
				</div>
				<SectionLink href="/projects/">all projects</SectionLink>
			</div>

			<ul class="project-grid">
				{projects.map((project) => {
					const { title, description, icon, status, version, links, color } = project.data;
					const href = `/projects/${project.id}/`;

					return (
						<li>
							<article class="project" style={`--project-color: ${color};`}>
								<div class="project-header">
									<a
										class="project-icon-link"
										href={href}
										tabindex="-1"
										aria-hidden="true"
									>
										<Image class="project-icon" src={icon} alt="" width={160} height={160} />
									</a>
									<div class="project-heading">
										<a class="project-title" href={href}>
											<h3>{title}</h3>
										</a>
										<div class="project-meta">
											<ProjectStatus status={status} />
											{version && <span class="project-version">{version}</span>}
										</div>
									</div>
								</div>
								<p class="project-description">{description}</p>
								{links.length > 0 && (
									<ul class="project-actions" aria-label={`${title} links`}>
										{links.map((link) => (
											<li>
												<a
													href={link.href}
													target={isExternal(link.href) ? '_blank' : undefined}
													rel={isExternal(link.href) ? 'noreferrer' : undefined}
												>
													{link.icon && (
														<span class="project-action-icon" aria-hidden="true">
															{link.icon}
														</span>
													)}
													{link.label}
												</a>
											</li>
										))}
									</ul>
								)}
							</article>
						</li>
					);
				})}
			</ul>
		</section>
	)
}

<style>
	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.section-heading h2 {
		margin: 0;
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project {
		--project-ink: color-mix(in srgb, var(--project-color) 60%, hsl(var(--foreground)));
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 1rem;
		border: 1px solid hsl(var(--border));
		border-radius: 0.75rem;
	}

	.project-header {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		width: 100%;
	}

	.project-icon-link {
		display: flex;
		flex: 0 0 auto;
		overflow: hidden;
		border-radius: 0.65rem;
	}

	.project-icon {
		width: 56px;
		height: 56px;
		border: 0;
		transition: transform 0.18s ease;
	}

	.project:hover .project-icon,
	.project:focus-within .project-icon {
		transform: scale(1.04);
	}

	.project-heading {
		min-width: 0;
	}

	.project-title {
		color: hsl(var(--foreground));
		text-decoration: none;
	}

	.project-heading h3 {
		margin: 0;
		font-size: 1.06rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.3;
		font-family: var(--font-sazanami);
		transition: color 0.16s ease;
	}

	.project:hover .project-title h3,
	.project:focus-within .project-title h3,
	.project-title:focus-visible h3 {
		color: var(--project-ink);
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		margin-top: 0.35rem;
	}

	.project-version {
		color: hsl(var(--foreground) / 0.62);
		font-size: 0.68rem;
		font-weight: 500;
		line-height: 1.4;
		white-space: nowrap;
	}

	.project-version::before {
		content: '·';
		margin-right: 0.4rem;
		opacity: 0.5;
	}

	.project-description {
		margin: 0.8rem 0 0;
		color: hsl(var(--foreground));
		font-family: var(--font-sazanami);
		font-size: 0.95rem;
		line-height: 1.65;
		text-wrap: pretty;
	}

	.project-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.1rem;
		margin: auto 0 0;
		padding: 1.1rem 0 0;
		list-style: none;
	}

	.project-actions a {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		color: hsl(var(--foreground) / 0.76);
		font-family: var(--font-sazanami);
		font-size: 0.8rem;
		font-weight: 600;
		line-height: 1.5;
		text-decoration: underline transparent;
		text-underline-offset: 0.22rem;
		transition:
			color 0.16s ease,
			text-decoration-color 0.16s ease;
	}

	.project-actions a:hover,
	.project-actions a:focus-visible {
		color: var(--project-ink);
		text-decoration-color: currentColor;
	}

	.project-action-icon {
		display: inline-flex;
		font-family: 'Symbols Nerd Font', var(--font-symbols);
		font-size: 0.95rem;
		line-height: 1;
	}

	@media (max-width: 859px) {
		.project-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 619px) {
		.project-grid {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project-title h3,
		.project-actions a,
		.project-icon {
			transition: none;
		}
	}
</style>
