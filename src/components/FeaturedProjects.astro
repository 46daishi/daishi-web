---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import PillLink from './PillLink.astro';
import ProjectStatus from './ProjectStatus.astro';

type Props = {
	projects: CollectionEntry<'projects'>[];
};

const { projects } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

{
	projects.length > 0 && (
		<section class="featured-projects" aria-labelledby="featured-projects-heading">
			<div class="section-heading">
				<h2 id="featured-projects-heading">featured projects</h2>
				<PillLink href="/projects/" icon="\uf005">
					All projects
				</PillLink>
			</div>

			<ul class="project-grid">
				{projects.map((project) => {
					const { title, description, icon, status, version, links, color } = project.data;
					const href = `/projects/${project.id}/`;

					return (
						<li>
							<article class="project" style={`--project-color: ${color};`}>
								<div class="project-header">
									<a
										class="project-icon-link"
										href={href}
										tabindex="-1"
										aria-hidden="true"
									>
										<Image class="project-icon" src={icon} alt="" width={160} height={160} />
									</a>
									<div class="project-heading">
										<a class="project-title" href={href}>
											<h3>{title}</h3>
										</a>
										<div class="project-meta">
											<ProjectStatus status={status} />
											{version && <span class="project-version">{version}</span>}
										</div>
									</div>
								</div>
								<p class="project-description">{description}</p>
								{links.length > 0 && (
									<ul class="project-actions" aria-label={`${title} links`}>
										{links.map((link) => (
											<li>
												<a
													href={link.href}
													target={isExternal(link.href) ? '_blank' : undefined}
													rel={isExternal(link.href) ? 'noreferrer' : undefined}
												>
													{link.icon && (
														<span class="project-action-icon" aria-hidden="true">
															{link.icon}
														</span>
													)}
													{link.label}
												</a>
											</li>
										))}
									</ul>
								)}
							</article>
						</li>
					);
				})}
			</ul>
		</section>
	)
}

<style>
	.section-heading {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.section-heading h2 {
		margin: 0;
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.project-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 2rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project {
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		padding: 0.85rem;
		border: 1px solid color-mix(in srgb, var(--project-color) 22%, hsl(var(--border)));
		border-top: 2px solid var(--project-color);
		border-radius: 0.75rem;
		background: color-mix(in srgb, var(--project-color) 4%, hsl(var(--card)));
		box-shadow: 0 2px 6px rgb(var(--black) / 0.04);
		text-align: left;
		transition:
			border-color 0.16s ease,
			background-color 0.16s ease,
			box-shadow 0.16s ease,
			transform 0.16s ease;
	}

	.project:hover,
	.project:focus-within {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--project-color) 48%, hsl(var(--border)));
		border-top-color: var(--project-color);
		background: color-mix(in srgb, var(--project-color) 7%, hsl(var(--card)));
		box-shadow: 0 8px 18px rgb(var(--black) / 0.1);
	}

	.project-header {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		width: 100%;
	}

	.project-icon-link {
		display: flex;
		flex: 0 0 auto;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--project-color) 25%, transparent);
		border-radius: 0.5rem;
		background: color-mix(in srgb, var(--project-color) 8%, hsl(var(--card)));
	}

	.project-icon {
		width: 64px;
		height: 64px;
		border: 0;
		transition: transform 0.16s ease;
	}

	.project:hover .project-icon,
	.project:focus-within .project-icon {
		transform: scale(1.04);
	}

	.project-heading {
		min-width: 0;
	}

	.project-title {
		color: hsl(var(--foreground));
		text-decoration: none;
	}

	.project-heading h3 {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.35;
		transition: color 0.16s ease;
	}

	.project:hover .project-title h3,
	.project:focus-within .project-title h3,
	.project-title:focus-visible h3 {
		color: var(--project-color);
	}

	.project-description {
		margin: 0.75rem 0 0;
		color: hsl(var(--foreground) / 0.82);
		font-size: 0.875rem;
		line-height: 1.55;
		text-align: left;
	}

	.project-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-start;
		gap: 0.5rem;
		margin: 0.35rem 0 0;
	}

	.project-version {
		font-size: 0.75rem;
		font-weight: 700;
		line-height: 1.4;
		white-space: nowrap;
	}

	.project-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-start;
		gap: 0.4rem;
		min-height: 30px;
		margin: auto 0 0;
		padding: 0.75rem 0 0;
		list-style: none;
		opacity: 0;
		pointer-events: none;
		transform: translateY(4px);
		transition:
			opacity 0.16s ease,
			transform 0.16s ease;
	}

	.project:hover .project-actions,
	.project:focus-within .project-actions {
		opacity: 1;
		pointer-events: auto;
		transform: none;
	}

	.project-actions a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		min-height: 30px;
		padding: 0.25rem 0.7rem;
		border: 1px solid color-mix(in srgb, var(--project-color) 22%, transparent);
		border-radius: 999px;
		background: color-mix(in srgb, var(--project-color) 12%, transparent);
		color: var(--project-color);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			background-color 0.16s ease,
			border-color 0.16s ease,
			color 0.16s ease,
			transform 0.16s ease;
	}

	.project-actions a:hover,
	.project-actions a:focus-visible {
		border-color: color-mix(in srgb, var(--project-color) 45%, transparent);
		background: color-mix(in srgb, var(--project-color) 20%, transparent);
		transform: translateY(-1px);
	}

	.project-action-icon {
		display: inline-flex;
		gap: 0.35rem;
		font-family: 'Symbols Nerd Font', var(--font-symbols);
		font-size: 0.9rem;
		line-height: 1;
	}

	@media (hover: none), (max-width: 719px) {
		.project-actions {
			opacity: 1;
			pointer-events: auto;
			transform: none;
		}
	}

	@media (max-width: 719px) {
		.project-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.project-actions {
			padding-top: 0.5rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.project,
		.project-title h3,
		.project-actions,
		.project-icon {
			transition: none;
		}
	}
</style>
