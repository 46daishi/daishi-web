---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	title: string;
	progressTitle: string;
	progress: number;
	description?: string;
	status?: string;
	href?: string;
	banner?: ImageMetadata;
	bannerY?: number;
	thumbnail?: ImageMetadata;
}

const {
	title,
	progressTitle,
	progress,
	description,
	status,
	href,
	banner,
	bannerY,
	thumbnail,
} = Astro.props;
const progressValue = Math.min(100, Math.max(0, progress));
const bannerPositionY = Math.min(100, Math.max(0, bannerY ?? 30));
const isExternal = href ? /^https?:\/\//.test(href) : false;
---

<section class="project-progress" aria-label={`${title} progress`}>
	<header class:list={['progress-header', { 'has-banner': banner }]}>
		{banner && (
			<span class="progress-banner-frame" aria-hidden="true">
				<Image
					class="progress-banner"
					src={banner}
					alt=""
					style={`--banner-offset-y: ${(50 - bannerPositionY) * 0.4}%;`}
				/>
			</span>
		)}
		<div class="progress-header-content">
			<h2>
				{href ? (
					<a href={href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noreferrer' : undefined}>
						{title}
					</a>
				) : (
					title
				)}
			</h2>
			{description && <p class="progress-description">{description}</p>}
		</div>
	</header>

	<div class="progress-details">
		<div class:list={['progress-summary', { 'has-thumbnail': thumbnail }]}>
			{thumbnail && (
				<Image class="progress-thumbnail" src={thumbnail} alt="" width={96} height={96} />
			)}
			<div class="progress-content">
				<div
					class="progress-track"
					role="progressbar"
					aria-label={`${progressTitle} completion`}
					aria-valuemin="0"
					aria-valuemax="100"
					aria-valuenow={Math.round(progressValue)}
				>
					<span class="progress-fill" style={`--progress-value: ${progressValue}%;`}></span>
				</div>
				<div class="progress-underbar">
					<div class="progress-copy">
						<h3>{progressTitle}</h3>
						{status && <p>{status}</p>}
					</div>
					<span class="progress-percent">{Math.round(progressValue)}%</span>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.project-progress {
		--progress-accent: hsl(var(--primary));
		overflow: hidden;
		margin: 2rem 0;
		border-radius: 0.9rem;
		background: color-mix(in srgb, var(--progress-accent) 5%, hsl(var(--card)));
		box-shadow: 0 2px 10px hsl(var(--foreground) / 0.1);
		color: hsl(var(--foreground));
		font-family: ui-sans-serif, system-ui, sans-serif;
	}

	.progress-header {
		position: relative;
		isolation: isolate;
		min-height: 6rem;
		overflow: hidden;
		padding: 0.9rem 1rem;
		background: linear-gradient(
			120deg,
			color-mix(in srgb, var(--progress-accent) 16%, hsl(var(--muted))),
			color-mix(in srgb, var(--progress-accent) 5%, hsl(var(--card)))
		);
	}

	.progress-header.has-banner {
		color: #fff;
		background: color-mix(in srgb, var(--progress-accent) 20%, #25262b);
	}

	.progress-banner-frame {
		position: absolute;
		z-index: -2;
		inset: 0 0 0 auto;
		width: 48%;
		overflow: hidden;
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 28%, #000 78%, transparent);
		mask-image: linear-gradient(90deg, transparent, #000 28%, #000 78%, transparent);
	}

	.progress-banner {
		width: 100%;
		height: 100%;
		margin: 0;
		border: 0;
		border-radius: 0;
		object-fit: cover;
		transform: translateY(var(--banner-offset-y, 8%)) scale(1.4);
		transform-origin: center;
	}

	.progress-header.has-banner::after {
		position: absolute;
		z-index: -1;
		inset: 0;
		background: linear-gradient(90deg, rgb(25 26 30 / 0.96), rgb(25 26 30 / 0.82) 52%, rgb(25 26 30 / 0.18));
		content: '';
	}

	:global(html[data-theme='light']) .progress-header.has-banner::after {
		background: linear-gradient(
			90deg,
			rgb(58 60 66 / 0.96),
			rgb(58 60 66 / 0.82) 52%,
			rgb(58 60 66 / 0.18)
		);
	}

	.progress-header-content {
		position: relative;
		max-width: 70%;
	}

	.progress-header h2 {
		margin: 0;
		font-size: clamp(1.1rem, 3vw, 1.35rem);
		font-weight: 600;
		line-height: 1.3;
	}

	.progress-header.has-banner h2 {
		color: #fff;
	}

	.progress-header h2 a {
		color: inherit;
		text-decoration-color: transparent;
		text-underline-offset: 0.2em;
		transition: text-decoration-color 0.16s ease;
	}

	.progress-header h2 a:hover,
	.progress-header h2 a:focus-visible {
		text-decoration-color: currentColor;
	}

	.progress-description {
		margin: 0.35rem 0 0;
		color: hsl(var(--muted-foreground));
		font-size: 0.85rem;
		line-height: 1.5;
		overflow-wrap: anywhere;
	}

	.progress-header.has-banner .progress-description {
		color: rgb(255 255 255 / 0.84);
	}

	.progress-details {
		padding: 0.75rem 1rem;
	}

	.progress-track {
		height: 0.4rem;
		overflow: hidden;
		border-radius: 999px;
		background: color-mix(in srgb, var(--progress-accent) 16%, hsl(var(--muted)));
	}

	.progress-fill {
		display: block;
		width: var(--progress-value);
		height: 100%;
		border-radius: inherit;
		background: hsl(var(--primary));
	}

	.progress-summary {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		align-items: flex-start;
		gap: 0.6rem;
	}

	.progress-summary.has-thumbnail {
		grid-template-columns: 3rem minmax(0, 1fr);
	}

	.progress-thumbnail {
		width: 3rem;
		height: 3rem;
		margin: 0;
		border: 1px solid color-mix(in srgb, var(--progress-accent) 28%, hsl(var(--border)));
		border-radius: 0.55rem;
		object-fit: cover;
	}

	.progress-content,
	.progress-copy {
		min-width: 0;
	}

	.progress-underbar {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.5rem;
		margin-top: 0.25rem;
	}

	.progress-copy h3 {
		margin: 0;
		font-size: 0.9rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.progress-copy p {
		margin: 0.15rem 0 0;
		color: hsl(var(--muted-foreground));
		font-size: 0.78rem;
		line-height: 1.4;
	}

	.progress-percent {
		flex: 0 0 auto;
		font-size: 0.85rem;
		font-variant-numeric: tabular-nums;
		text-align: right;
	}

	@media (max-width: 520px) {
		.progress-header {
			min-height: 5.25rem;
			padding: 0.8rem 0.85rem;
		}

		.progress-details {
			padding: 0.7rem 0.85rem;
		}

		.progress-header-content {
			max-width: 78%;
		}

	}

	@media (prefers-reduced-motion: reduce) {
		.progress-header h2 a {
			transition: none;
		}
	}
</style>
