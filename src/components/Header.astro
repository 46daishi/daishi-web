---
import { Image } from 'astro:assets';
import hana from '../assets/46hana.png';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

interface Props {
	projectName?: string;
}

const { projectName } = Astro.props;

const [siteName, ...siteDomainParts] = SITE_TITLE.split('.');
const siteDomain = siteDomainParts.join('.');

const navItems = [
	{ href: '/projects', label: 'projects' },
	{ href: '/blog', label: 'blog' },
	{ href: '/about', label: 'about' },
];
---

<header class="site-header">
	<div class="header-inner">
		<a class="brand" href="/" aria-label={`${SITE_TITLE} — home`}>
			<span class="brand-mark" aria-hidden="true">
				<Image src={hana} alt="" width={36} height={36} />
			</span>
			<span class="brand-name">
				{siteName}{siteDomain && <span class="brand-domain">.{siteDomain}</span>}
			</span>
		</a>

		{projectName && (
			<span class="brand-name project-name">
				<span class="project-prefix" aria-hidden="true">/ </span>{projectName}
			</span>
		)}

		<nav class="site-nav" aria-label="Primary navigation">
			<ul>
				{navItems.map((item, index) => (
					<li>
						{index > 0 && (
							<span class="nav-sep" aria-hidden="true">
								<Image src={hana} alt="" width={24} height={24} />
							</span>
						)}
						<HeaderLink href={item.href}>{item.label}</HeaderLink>
					</li>
				))}
			</ul>
		</nav>

		<div class="header-actions">
			<button
				type="button"
				class="theme-toggle"
				role="switch"
				aria-checked="false"
				aria-label="Switch to dark theme"
				title="Switch to dark theme"
				data-theme-toggle
			>
				<span class="theme-track" aria-hidden="true">
					<span class="theme-knob">
						<span class="theme-icon theme-icon-sun" aria-hidden="true">{'\uf185'}</span>
						<span class="theme-icon theme-icon-moon" aria-hidden="true">{'\uf186'}</span>
					</span>
				</span>
			</button>
		</div>
	</div>
</header>

<script>
	const root = document.documentElement;
	const toggle = document.querySelector('[data-theme-toggle]');
	const media = window.matchMedia('(prefers-color-scheme: dark)');

	const syncTheme = () => {
		if (!toggle) return;
		const dark = root.dataset.theme === 'dark';
		toggle.setAttribute('aria-checked', String(dark));
		toggle.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
		toggle.title = dark ? 'Switch to light theme' : 'Switch to dark theme';
	};

	const setTheme = (theme) => {
		root.dataset.theme = theme;
		syncTheme();
	};

	toggle?.addEventListener('click', () => {
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		setTheme(next);
		try {
			localStorage.setItem('daishi-theme', next);
		} catch {}
	});

	media.addEventListener('change', (event) => {
		try {
			if (localStorage.getItem('daishi-theme')) return;
		} catch {}
		setTheme(event.matches ? 'dark' : 'light');
	});

	syncTheme();
</script>

<style>
	.site-header {
		width: 100%;
	}

	.header-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1rem;
		width: 100%;
		max-width: 932px;
		min-height: 60px;
		margin: 0 auto;
		padding: 0.25rem 1rem;
		border-bottom: 1px solid hsl(var(--border));
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		min-height: 44px;
		flex-shrink: 0;
		color: hsl(var(--foreground));
		text-decoration: none;
		transition: color 0.16s ease;
	}

	.brand-mark {
		display: inline-flex;
		flex: 0 0 18px;
		width: 18px;
		height: 18px;
		opacity: 0.9;
	}

	.brand-mark :global(img) {
		width: 18px;
		height: 18px;
		border: 0;
	}

	.brand-name {
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.05em;
	}

	.project-name {
		color: hsl(var(--primary));
		text-transform: lowercase;
	}

	.project-prefix {
		color: hsl(var(--foreground));
	}

	.brand-domain {
		color: hsl(var(--primary));
	}

	.brand:hover .brand-name,
	.brand:focus-visible .brand-name {
		color: hsl(var(--primary));
	}

	.site-nav {
		margin-left: auto;
		min-width: 0;
	}

	.site-nav ul {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-nav li {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.nav-sep {
		display: inline-flex;
		flex: 0 0 12px;
		align-items: center;
		justify-content: center;
		width: 12px;
		height: 12px;
		opacity: 0.7;
	}

	.nav-sep :global(img) {
		width: 12px;
		height: 12px;
		border: 0;
	}

	.site-nav a {
		display: inline-flex;
		align-items: center;
		min-height: 40px;
		color: hsl(var(--muted-foreground));
		font-size: 0.75rem;
		font-weight: 800;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		transition: color 0.16s ease;
	}

	.site-nav a:hover,
	.site-nav a:focus-visible,
	.site-nav a.active {
		color: hsl(var(--primary));
	}

	.header-actions {
		display: flex;
		align-items: center;
	}

	.theme-toggle {
		display: grid;
		place-items: center;
		width: 44px;
		height: 44px;
		padding: 2px;
		border: 0;
		border-radius: 999px;
		background: transparent;
		cursor: pointer;
	}

	.theme-track {
		position: relative;
		display: block;
		width: 40px;
		height: 22px;
		overflow: hidden;
		background: hsl(var(--muted));
		border-radius: 999px;
		box-shadow: inset 0 0 0 1px hsl(var(--border));
		transition: background-color 0.18s ease;
	}

	.theme-knob {
		position: absolute;
		top: 3px;
		left: 3px;
		z-index: 1;
		display: grid;
		place-items: center;
		width: 16px;
		height: 16px;
		color: hsl(var(--background));
		background: hsl(var(--muted-foreground));
		border: 1px solid hsl(var(--muted-foreground));
		border-radius: 50%;
		box-shadow: 0 1px 2px hsl(var(--foreground) / 0.2);
		transition:
			transform 0.18s ease,
			background-color 0.18s ease,
			border-color 0.18s ease;
	}

	.theme-icon {
		display: block;
		font-family: var(--font-symbols);
		font-size: 11px;
		font-style: normal;
		font-weight: 400;
		line-height: 1;
	}

	.theme-icon-moon {
		display: none;
	}

	:global(:root[data-theme='dark']) .theme-knob {
		color: hsl(var(--primary-foreground));
		background: hsl(var(--primary));
		border-color: hsl(var(--primary));
		transform: translateX(18px);
	}

	:global(:root[data-theme='dark']) .theme-icon-sun {
		display: none;
	}

	:global(:root[data-theme='dark']) .theme-icon-moon {
		display: block;
	}

	@media (max-width: 719px) {
		.header-inner {
			gap: 0.35rem 0.75rem;
			padding-top: 0.55rem;
			padding-bottom: 0.35rem;
		}

		.site-nav {
			flex-basis: 100%;
			order: 3;
			margin-left: 0;
		}

		.site-nav ul {
			gap: 0.5rem;
		}

		.site-nav li {
			gap: 0.5rem;
		}

		.site-nav a {
			min-height: 36px;
		}

		.header-actions {
			margin-left: auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.brand,
		.site-nav a,
		.theme-toggle,
		.theme-track,
		.theme-knob {
			transition: none;
		}
	}
</style>
