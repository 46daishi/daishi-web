---
import { Image } from 'astro:assets';
import hana from '../assets/46hana.png';

const today = new Date();
---

<footer>
	<div class="footer-inner">
		<span class="footer-sep" aria-hidden="true">
			<Image src={hana} alt="" width={24} height={24} />
		</span>
		<p class="copyright">
			46dai &copy; {today.getFullYear()}
		</p>
		
	</div>
</footer>

<style>
	footer {
		color: hsl(var(--muted-foreground));
		font-size: 0.75rem;
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.25rem 0.75rem;
		width: 100%;
		max-width: 932px;
		margin: 0 auto;
		padding: 0.6rem 1rem;
		border-top: 1px solid hsl(var(--border));
	}

	.copyright {
		margin: 0;
	}

	.footer-sep {
		display: inline-flex;
		flex: 0 0 12px;
		align-items: center;
		justify-content: center;
		width: 12px;
		height: 12px;
		opacity: 0.55;
	}

	.footer-sep :global(img) {
		width: 12px;
		height: 12px;
		border: 0;
	}

	@media (max-width: 480px) {
		.footer-inner {
			gap: 0.25rem 0.5rem;
		}

		.rights {
			display: none;
		}

		.social-links a {
			width: 28px;
			height: 28px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.social-links a {
			transition: none;
		}
	}
</style>
