---
import { PROJECT_STATUS_LABELS, type ProjectStatus } from '../consts';

type Props = {
	status: ProjectStatus;
};

const { status } = Astro.props;
---

<span class:list={['project-status', `status-${status}`]}>
	{PROJECT_STATUS_LABELS[status]}
</span>

<style>
	.project-status {
		display: inline-flex;
		align-items: center;
		color: hsl(var(--muted-foreground));
		font-size: 0.68rem;
		font-weight: 600;
		line-height: 1.4;
		white-space: nowrap;
	}

	.project-status::before {
		content: '';
		display: inline-block;
		width: 6px;
		height: 6px;
		margin-right: 0.4rem;
		background: currentColor;
		border-radius: 50%;
	}

	.status-active {
		color: hsl(142 72% 29%);
	}

	:global(:root[data-theme='dark']) .status-active {
		color: hsl(142 70% 55%);
	}
</style>
