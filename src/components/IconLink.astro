---
interface Props {
	href: string;
	icon: string;
}

const { href, icon } = Astro.props;
---

<a class="icon-link" href={href}>
	<span class="icon-link-icon" aria-hidden="true">{icon}</span>
	<slot />
</a>

<style>
	.icon-link {
		display: inline-flex;
		align-items: baseline;
		gap: 0.35em;
		color: hsl(var(--primary));
		font-family: var(--font-sazanami);
		font-size: 1.15rem;
	}

	:global(.project-content) .icon-link {
		color: hsl(var(--primary));
	}

	.icon-link-icon {
		font-family: var(--font-symbols);
		font-size: 0.9em;
		line-height: 1;
	}
</style>
