---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import hana from '../assets/46hana.png';

interface Props {
	compact?: boolean;
	icon?: ImageMetadata;
	color?: string;
}

const { compact = false, icon, color } = Astro.props;
---

<div
	class:list={['hana-divider', { compact }]}
	style={
		color
			? `--divider-color: color-mix(in srgb, ${color} 38%, hsl(var(--border)));`
			: undefined
	}
	aria-hidden="true"
>
	<span class="hana-line"></span>
	<span class="hana-mark">
		<Image class="hana-icon" src={icon ?? hana} alt="" width={72} height={72} />
	</span>
	<span class="hana-line"></span>
</div>

<style>
	.hana-divider {
		display: flex;
		align-items: center;
		gap: 1rem;
		width: 100%;
		margin: 2rem 0;
	}

	.hana-line {
		flex: 1;
		height: 1px;
		background: linear-gradient(
			90deg,
			transparent,
			var(--divider-color, hsl(var(--border))) 18%,
			var(--divider-color, hsl(var(--border))) 82%,
			transparent
		);
	}

	.hana-mark {
		display: grid;
		flex: 0 0 auto;
		place-items: center;
		width: 38px;
		height: 38px;
		background: hsl(var(--background));
		border: 1px solid var(--divider-color, hsl(var(--border)));
		border-radius: 50%;
		box-shadow:
			0 0 0 3px hsl(var(--background)),
			0 0 0 4px var(--divider-color, hsl(var(--border)));
	}

	.hana-icon {
		width: 22px;
		height: 22px;
		margin: 0;
		border: 0;
		opacity: 0.72;
	}

	.hana-divider.compact {
		margin: 1.25rem 0;
	}

	@media (max-width: 719px) {
		.hana-divider {
			gap: 0.75rem;
			margin: 1.75rem 0;
		}

		.hana-icon {
			width: 16px;
			height: 16px;
		}
	}
</style>
