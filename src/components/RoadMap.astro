---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type RoadMapVersion = {
	version: string;
	date: string;
	current?: boolean;
} & (
	| { features: string[]; description?: never }
	| { description: string; features?: never }
);

interface Props {
	versions: RoadMapVersion[];
	logo?: ImageMetadata;
}

const { versions, logo } = Astro.props;
---

<section class="roadmap" aria-label="Project roadmap">
	<div class="roadmap-viewport">
		<button class="roadmap-arrow is-left" type="button" data-dir="-1" aria-label="Previous version" hidden>
			<span aria-hidden="true">{'\uf104'}</span>
		</button>
		<div class="roadmap-scroll" tabindex="0" aria-label="Scrollable project versions">
			<ol class="roadmap-track">
				{versions.map(({ version, date, features, description, current }) => {
					const isCurrent = current === true;

					return (
						<li
							class:list={['roadmap-entry', { 'is-current': isCurrent }]}
							aria-current={isCurrent ? 'step' : undefined}
						>
							<div class="roadmap-head">
								<span class="roadmap-version">{version}</span>
							</div>
							<time class="roadmap-date">{date}</time>

							<div class="roadmap-rail" aria-hidden="true">
								{logo ? (
									<span class="roadmap-logo-frame">
										<Image
											class="roadmap-logo"
											src={logo}
											alt=""
											width={40}
											height={40}
										/>
									</span>
								) : (
									<span class="roadmap-dot"></span>
								)}
							</div>

							{description ? (
								<p class="roadmap-description">{description}</p>
							) : (
								<ul class="roadmap-features">
									{features?.map((feature) => (
										<li>{feature}</li>
									))}
								</ul>
							)}
						</li>
					);
				})}
			</ol>
		</div>
		<button class="roadmap-arrow is-right" type="button" data-dir="1" aria-label="Next version" hidden>
			<span aria-hidden="true">{'\uf105'}</span>
		</button>
	</div>
</section>

<script>
	document.querySelectorAll<HTMLElement>('.roadmap').forEach((root) => {
		const scroller = root.querySelector<HTMLElement>('.roadmap-scroll');
		const viewport = root.querySelector<HTMLElement>('.roadmap-viewport');
		const rail = root.querySelector<HTMLElement>('.roadmap-rail');
		const current = root.querySelector<HTMLElement>('.roadmap-entry.is-current');
		const entries = Array.from(root.querySelectorAll<HTMLElement>('.roadmap-entry'));
		const leftArrow = root.querySelector<HTMLButtonElement>('.roadmap-arrow.is-left');
		const rightArrow = root.querySelector<HTMLButtonElement>('.roadmap-arrow.is-right');
		if (!scroller) return;

		if (viewport && rail) {
			const alignArrowsToRail = () => {
				const viewportTop = viewport.getBoundingClientRect().top;
				const railCenter = rail.getBoundingClientRect().top + rail.offsetHeight / 2;
				const top = `${railCenter - viewportTop}px`;
				if (leftArrow) leftArrow.style.top = top;
				if (rightArrow) rightArrow.style.top = top;
			};
			const positionObserver = new ResizeObserver(alignArrowsToRail);
			positionObserver.observe(viewport);
			positionObserver.observe(rail);
			alignArrowsToRail();
		}

		if (current) {
			const prev = scroller.style.scrollBehavior;
			scroller.style.scrollBehavior = 'auto';
			scroller.scrollLeft = Math.max(
				0,
				current.offsetLeft - (scroller.clientWidth - current.offsetWidth) / 2
			);
			scroller.style.scrollBehavior = prev;
		}

		const first = entries[0];
		const last = entries[entries.length - 1];
		if (first && last && leftArrow && rightArrow) {
			const edgeObserver = new IntersectionObserver(
				(observations) => {
					for (const observation of observations) {
						if (observation.target === first) leftArrow.hidden = observation.isIntersecting;
						if (observation.target === last) rightArrow.hidden = observation.isIntersecting;
					}
				},
				{ root: scroller },
			);
			edgeObserver.observe(first);
			if (last !== first) edgeObserver.observe(last);
		}

		root.querySelectorAll<HTMLButtonElement>('.roadmap-arrow').forEach((btn) => {
			btn.addEventListener('click', () => {
				const direction = Number(btn.dataset.dir || 1);
				const viewportCenter = scroller.getBoundingClientRect().left + scroller.clientWidth / 2;
				const currentIndex = entries.reduce(
					(closestIndex, entry, index) => {
						const closest = entries[closestIndex];
						const closestCenter = closest.getBoundingClientRect().left + closest.offsetWidth / 2;
						const entryCenter = entry.getBoundingClientRect().left + entry.offsetWidth / 2;
						return Math.abs(entryCenter - viewportCenter) < Math.abs(closestCenter - viewportCenter)
							? index
							: closestIndex;
					},
					0,
				);
				const next = entries[currentIndex + direction];
				if (!next) return;

				const nextLeft =
					next.getBoundingClientRect().left -
					scroller.getBoundingClientRect().left +
					scroller.scrollLeft;
				scroller.scrollTo({
					left: nextLeft - (scroller.clientWidth - next.offsetWidth) / 2,
					behavior: 'smooth',
				});
			});
		});
	});
</script>

<style>
	.roadmap {
		--plain: #444;
		--accent: hsl(var(--primary));
		--arrow-color: #000;
		margin: 2rem 0;
		font-family: ui-sans-serif, system-ui, sans-serif;
	}

	:global(html[data-theme='dark']) .roadmap {
		--arrow-color: #fff;
	}

	.roadmap-viewport {
		position: relative;
	}

	.roadmap-arrow {
		position: absolute;
		z-index: 1;
		top: 50%;
		display: grid;
		place-items: center;
		width: 2.25rem;
		height: 2.25rem;
		transform: translateY(-50%);
		border: 0;
		background: transparent;
		color: var(--arrow-color);
		cursor: pointer;
		font-family: var(--font-symbols);
		font-size: 1.5rem;
		line-height: 1;
		opacity: 0.85;
	}

	.roadmap-arrow[hidden] {
		display: none;
	}

	.roadmap-arrow.is-left {
		left: 0.25rem;
	}

	.roadmap-arrow.is-right {
		right: 0.25rem;
	}

	.roadmap-arrow:hover,
	.roadmap-arrow:focus-visible {
		opacity: 1;
	}

	.roadmap-scroll {
		overflow-x: auto;
		padding-bottom: 0.5rem;
		scroll-behavior: smooth;
		scroll-snap-type: x proximity;
		scrollbar-width: none;
	}

	.roadmap-scroll::-webkit-scrollbar {
		display: none;
	}

	.roadmap-track {
		display: flex;
		width: max-content;
		min-width: 100%;
		margin: 0;
		padding: 0 1rem;
		list-style: none;
	}

	/* ~3 entries fit across the container */
	.roadmap-entry {
		flex: 0 0 clamp(9.5rem, 31%, 14rem);
		scroll-snap-align: center;
	}

	.roadmap-logo-frame {
		position: relative;
		z-index: 1;
		display: block;
		width: 2.25rem;
		height: 2.25rem;
		overflow: hidden;
		border: 2px solid hsl(var(--background));
		border-radius: 50%;
		background: hsl(var(--background));
	}

	.roadmap-logo {
		width: 100%;
		height: 100%;
		margin: 0;
		border: 0;
		border-radius: inherit;
		object-fit: cover;
		filter: grayscale(1) brightness(0.65);
	}

	.roadmap-entry.is-current .roadmap-logo {
		filter: none;
	}

	.roadmap-rail {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		height: 2.25rem;
		margin: 0.6rem 0;
	}

	.roadmap-rail::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 50%;
		height: 3px;
		transform: translateY(-50%);
		background: var(--plain);
	}

	.roadmap-entry:first-child .roadmap-rail::before {
		left: 50%;
	}

	.roadmap-entry:last-child .roadmap-rail::before {
		right: 50%;
	}

	.roadmap-dot {
		position: relative;
		z-index: 1;
		width: 0.75rem;
		height: 0.75rem;
		border: 2px solid hsl(var(--background));
		border-radius: 50%;
		background: var(--plain);
	}

	.roadmap-entry.is-current .roadmap-dot {
		background: var(--accent);
		box-shadow: 0 0 0 1px var(--accent);
	}

	.roadmap-head {
		text-align: center;
	}

	.roadmap-version {
		font-size: 1rem;
		font-weight: 600;
	}

	.roadmap-entry.is-current .roadmap-version {
		color: var(--accent);
	}

	.roadmap-date {
		display: block;
		text-align: center;
		margin: -0.1rem 0 0.45rem;
		font-size: 0.78rem;
		opacity: 0.65;
	}

	.roadmap-features {
		margin: 0;
		padding: 0 0.5rem 0 1.35rem;
		font-size: 0.78rem;
		line-height: 1.4;
		list-style: disc;
	}

	.roadmap-description {
		margin: 0;
		padding: 0 0.5rem;
		font-size: 0.82rem;
		line-height: 1.5;
	}

	@media (prefers-reduced-motion: reduce) {
		.roadmap-scroll {
			scroll-behavior: auto;
		}
	}
</style>