---
interface Props {
	date: Date;
	format?: 'en' | 'ja';
}

const { date, format = 'en' } = Astro.props;
const month = String(date.getMonth() + 1).padStart(2, '0');
const day = String(date.getDate()).padStart(2, '0');
---

<time datetime={date.toISOString()} lang={format === 'ja' ? 'ja' : undefined}>
	{
		format === 'ja' ? (
			<>
				{date.getFullYear()}
				<span class="date-ja">年</span> {month}
				<span class="date-ja">月</span> {day}
				<span class="date-ja">日</span>
			</>
		) : (
			date.toLocaleDateString('en-us', {
				year: 'numeric',
				month: 'short',
				day: 'numeric',
			})
		)
	}
</time>
