---
interface Props {
	date: Date;
	format?: 'en' | 'ja';
}

const { date, format = 'en' } = Astro.props;

const formatted =
	format === 'ja'
		? `${date.getFullYear()}年 ${String(date.getMonth() + 1).padStart(2, '0')}月 ${String(date.getDate()).padStart(2, '0')}日`
		: date.toLocaleDateString('en-us', {
				year: 'numeric',
				month: 'short',
				day: 'numeric',
			});
---

<time datetime={date.toISOString()} lang={format === 'ja' ? 'ja' : undefined}>{formatted}</time>
