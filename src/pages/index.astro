---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import pfp from '../assets/pfp.jpg';
import blogFallback from '../assets/blog-placeholder-1.jpg';
import cursorSprite from '../assets/icons/cursor0.bmp?url';
import BaseHead from '../components/BaseHead.astro';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import HanaDivider from '../components/HanaDivider.astro';
import Header from '../components/Header.astro';
import SectionLink from '../components/SectionLink.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latestPosts = posts.slice(0, 5);
const featuredPosts = posts.filter((post) => post.data.featured).slice(0, 3);
const projects = await getCollection('projects');

const logEntries = (await getCollection('log')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const renderedLogEntries = await Promise.all(
	logEntries.map(async (entry) => {
		const { Content } = await render(entry);
		return { entry, Content };
	}),
);
const formatLogDate = new Intl.DateTimeFormat('ja-JP', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});

const featuredProjects = projects
	.filter((project) => project.data.featured && project.data.status === 'active')
	.sort(
		(a, b) =>
			a.data.featuredOrder - b.data.featuredOrder || a.data.title.localeCompare(b.data.title),
	)
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home-page">
			<section class="intro" aria-labelledby="intro-heading">
				<div class="intro-aside">
					<figure class="portrait">
						<Image src={pfp} alt="daishi's profile picture" width={360} height={360} loading="eager" />
						<figcaption>
							pfp source <a href="https://x.com/nngw_000" target="_blank" rel="noreferrer">@nngw_000</a>
						</figcaption>
					</figure>
					<div class="social-links">
						<a href="https://x.com/46daishi" target="_blank">
							<span class="sr-only">@46daishi</span>
							<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">
								<path
									fill="currentColor"
									d="M5.026 15c6.038 0 9.341-5.003 9.341-9.334 0-.14 0-.282-.006-.422A6.685 6.685 0 0 0 16 3.542a6.658 6.658 0 0 1-1.889.518 3.301 3.301 0 0 0 1.447-1.817 6.533 6.533 0 0 1-2.087.793A3.286 3.286 0 0 0 7.875 6.03a9.325 9.325 0 0 1-6.767-3.429 3.289 3.289 0 0 0 1.018 4.382A3.323 3.323 0 0 1 .64 6.575v.045a3.288 3.288 0 0 0 2.632 3.218 3.203 3.203 0 0 1-.865.115 3.23 3.23 0 0 1-.614-.057 3.283 3.283 0 0 0 3.067 2.277A6.588 6.588 0 0 1 .78 13.58a6.32 6.32 0 0 1-.78-.045A9.344 9.344 0 0 0 5.026 15z"
								></path>
							</svg>
						</a>
						<a href="https://github.com/46daishi" target="_blank">
							<span class="sr-only">@46daishi</span>
							<svg viewBox="0 0 16 16" aria-hidden="true" width="16" height="16">
								<path
									fill="currentColor"
									d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
								></path>
							</svg>
						</a>
						<a href="https://discord.gg/fHJJm4jpwV" target="_blank" rel="noreferrer">
							<span class="sr-only">46hana</span>
							<svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16">
								<path
									fill="currentColor"
									d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"
								></path>
							</svg>
						</a>
					</div>
				</div>
				<div class="intro-copy">
					<span class="section-kicker" lang="ja">自己紹介</span>
					<h1 id="intro-heading">46<span>dai</span></h1>
					<p class="intro-bio" data-typewriter>
						<span class="intro-bio-ghost" aria-hidden="true">I like to write and read VNs, study 日本語, and code fun apps on the side. Also a big enthusiast of riichi mahjong and tinkering with Linux<span class="intro-bio-cursor-space"></span></span>
						<span class="intro-bio-live"><span aria-hidden="true" data-typewriter-target></span><a
							class="intro-bio-cursor"
							href="#featured-projects"
							aria-label="Continue to featured projects"
							data-typewriter-cursor
							style={`--cursor-sprite: url(${cursorSprite})`}
						></a></span>
						<span class="sr-only" data-typewriter-source>I like to write and read VNs, study 日本語, and code fun apps on the side. Also a big enthusiast of riichi mahjong and tinkering with Linux</span>
					</p>
					<blockquote class="intro-now">
						<span class="now-label">status</span>: building the website, writing soul garden
					</blockquote>
				</div>
			</section>

			<HanaDivider />

			<FeaturedProjects projects={featuredProjects} />

			{featuredPosts.length > 0 && (
				<section class="featured-posts" aria-labelledby="featured-posts-heading">
					<div class="section-heading">
						<div>
							<span class="section-kicker" lang="ja">特集</span>
							<h2 id="featured-posts-heading">featured posts</h2>
						</div>
					</div>
					<ul class="featured-post-tiles">
						{featuredPosts.map((post) => (
							<li>
								<a class="featured-post-tile" href={`/blog/${post.id}/`}>
									<Image
										class="featured-post-tile-image"
										src={post.data.heroImage ?? blogFallback}
										alt=""
										width={640}
										height={256}
									/>
									<span class="featured-post-tile-body">
										<FormattedDate date={post.data.pubDate} format="ja" />
										<span class="featured-post-tile-title">{post.data.title}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}

			<section class="home-blog" aria-label="Posts and updates">
				<section class="latest-posts" aria-labelledby="latest-posts-heading">
					<div class="section-heading">
						<div>
							<span class="section-kicker" lang="ja">最新記事</span>
							<h2 id="latest-posts-heading">latest blog posts</h2>
						</div>
						<SectionLink href="/blog/">all posts</SectionLink>
					</div>
					<ul>
						{latestPosts.map((post) => {
							const project = projects.find((project) => project.id === post.data.project);

							return (
								<li>
									<article class="latest-post">
										<a
											class="latest-post-image-link"
											href={`/blog/${post.id}/`}
											tabindex="-1"
											aria-hidden="true"
										>
											<Image
												src={post.data.heroImage ?? blogFallback}
												alt=""
												width={320}
												height={180}
											/>
										</a>
										<div class="latest-post-body">
											<a class="latest-post-title" href={`/blog/${post.id}/`}>
												{post.data.title}
											</a>
											<div class="post-meta">
												<FormattedDate date={post.data.pubDate} format="ja" />
												{post.data.tags.map((tag) => (
													<span class="post-tag">#{tag.trim().replace(/\s+/g, '-')}</span>
												))}
												{project && (
													<a
														class="post-project"
														href={`/projects/${post.data.project}/`}
														style={`--project-color: ${project.data.color};`}
													>
														#{post.data.project}
													</a>
												)}
											</div>
										</div>
									</article>
								</li>
							);
						})}
					</ul>
				</section>

				<section class="site-log" aria-labelledby="log-heading">
					<div class="section-heading">
						<div>
							<span class="section-kicker" lang="ja">日誌</span>
							<h2 id="log-heading">log</h2>
						</div>
					</div>
					<div class="log-terminal">
						<div class="log-terminal-bar" aria-hidden="true">
							<span class="log-terminal-dots">
								<span></span>
								<span></span>
								<span></span>
							</span>
							<span class="log-terminal-path">~/log</span>
							<span class="log-terminal-cursor"></span>
						</div>
						<ul class="log-list">
							{renderedLogEntries.map(({ entry, Content }) => (
								<li>
									<article class="log-entry">
										<time
											class="log-date"
											datetime={entry.data.date.toISOString()}
											lang="ja"
										>
											{formatLogDate.format(entry.data.date)}
										</time>
										<div class="log-body">
											<Content />
										</div>
									</article>
								</li>
							))}
						</ul>
					</div>
				</section>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home-page {
		padding-top: 2rem;
		padding-bottom: 2rem;
	}

	.home-page :global(.hana-divider) {
		margin: 1.5rem 0;
	}

	.intro {
		display: flex;
		align-items: flex-start;
		gap: 2rem;
		padding-top: 0.5rem;
	}

	.intro-aside {
		display: flex;
		flex: 0 0 clamp(7.5rem, 16vw, 11rem);
		flex-direction: column;
	}

	.portrait {
		position: relative;
		overflow: hidden;
		margin: 0;
		border-radius: 0.75rem;
	}

	.portrait :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.75rem;
	}

	.portrait figcaption {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		margin: 0;
		padding: 1.5rem 0.35rem 0.35rem;
		background: linear-gradient(180deg, transparent, rgb(0 0 0 / 0.78));
		color: rgb(255 255 255 / 0.8);
		font-family: var(--font-mono);
		font-size: 0.6rem;
		line-height: 1.4;
		text-align: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.16s ease;
	}

	.portrait figcaption a {
		color: rgb(255 255 255 / 0.92);
	}

	.portrait:hover figcaption,
	.portrait:focus-within figcaption {
		opacity: 1;
		pointer-events: auto;
	}

	.intro-copy {
		flex: 1 1 auto;
		min-width: 0;
	}

	.intro-copy h1 {
		margin: 0 0 0.75rem;
		font-size: clamp(2.5rem, 6vw, 3.5rem);
		line-height: 1;
		letter-spacing: -0.07em;
	}

	.intro-copy h1 span {
		color: hsl(var(--primary));
	}

	.intro-bio {
		position: relative;
		max-width: 36rem;
		margin: 0;
		color: hsl(var(--foreground));
		font-family: var(--font-sazanami);
		font-size: 1.12rem;
		line-height: 1.65;
	}

	:global(:root[data-theme='dark']) .intro-bio {
		color: #fff;
	}

	:global(html.js) .intro-bio-ghost {
		visibility: hidden;
	}

	.intro-bio-cursor-space {
		display: inline-block;
		width: calc(16px + 0.4rem);
		height: 1px;
	}

	.intro-bio-live {
		display: none;
	}

	:global(html.js) .intro-bio-live {
		position: absolute;
		inset: 0;
		display: block;
	}

	.intro-bio-cursor {
		display: none;
		width: 16px;
		height: 16px;
		margin-left: 0.4rem;
		vertical-align: -0.12em;
		background-image: var(--cursor-sprite);
		background-repeat: no-repeat;
		background-position: 0 0;
		background-size: 64px 16px;
		image-rendering: pixelated;
		text-decoration: none;
		animation: intro-cursor-frames 0.7s steps(4) infinite;
	}

	:global(html.js) .intro-bio.is-complete .intro-bio-cursor {
		display: inline-block;
	}

	@keyframes intro-cursor-frames {
		to {
			background-position-x: -64px;
		}
	}

	.intro-now {
		margin: 0.85rem 0 0;
		padding: 0.4rem 0.65rem;
		border-left: 2px solid hsl(var(--primary));
		border-radius: 0 var(--radius) var(--radius) 0;
		background: hsl(var(--muted) / 0.55);
		color: hsl(var(--muted-foreground));
		font-size: 0.82rem;
		line-height: 1.6;
	}

	.now-label {
		color: hsl(var(--foreground) / 0.8);
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.intro-now a {
		color: inherit;
		text-decoration-color: hsl(var(--muted-foreground) / 0.5);
		text-underline-offset: 0.15em;
	}

	.intro-now a:hover,
	.intro-now a:focus-visible {
		color: hsl(var(--primary));
	}

	.social-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.1rem;
		margin-top: 0.4rem;
		color: hsl(var(--muted-foreground));
	}

	.social-links a {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		color: inherit;
		text-decoration: none;
		transition: color 0.16s ease;
	}

	.social-links a:hover,
	.social-links a:focus-visible {
		color: hsl(var(--primary));
	}

	.social-links svg {
		width: 16px;
		height: 16px;
	}

	.featured-posts {
		margin: 3rem 0 3.5rem;
	}

	.featured-posts .section-heading {
		margin-bottom: 0.75rem;
	}

	.featured-post-tiles {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.featured-post-tiles li {
		display: flex;
		min-width: 0;
	}

	.featured-post-tile {
		position: relative;
		display: flex;
		flex: 1;
		flex-direction: column;
		min-width: 0;
		overflow: hidden;
		border: 1px solid hsl(var(--border));
		background: hsl(var(--card));
		color: hsl(var(--foreground));
		text-decoration: none;
		transition: border-color 0.16s ease;
	}

	.featured-post-tile-image {
		display: block;
		width: 100%;
		aspect-ratio: 12 / 5;
		border: 0;
		object-fit: cover;
		object-position: center top;
	}

	.featured-post-tile-body {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		padding: 2rem 0.7rem 0.6rem;
		background: linear-gradient(180deg, transparent, rgb(0 0 0 / 0.82));
		color: white;
	}

	.featured-post-tile-body :global(time) {
		align-self: flex-start;
		padding: 0.15rem 0.4rem;
		border-radius: var(--radius);
		background: rgb(0 0 0 / 0.82);
		color: #fff;
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		line-height: 1.4;
	}

	.featured-post-tile-title {
		display: -webkit-box;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		color: white;
		font-family: var(--font-serif);
		font-size: 1rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.25;
	}

	.featured-post-tile:hover,
	.featured-post-tile:focus-visible {
		border-color: hsl(var(--primary) / 0.5);
	}

	.featured-post-tile:hover .featured-post-tile-title,
	.featured-post-tile:focus-visible .featured-post-tile-title {
		color: hsl(var(--primary));
	}

	.home-blog {
		display: grid;
		grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
		align-items: stretch;
		gap: 2rem;
	}

	.section-heading {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		min-height: 1.5rem;
		margin-bottom: 1.25rem;
	}

	.section-heading h2 {
		margin: 0;
		font-size: 1.3rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.latest-posts,
	.site-log {
		display: flex;
		flex-direction: column;
	}

	.site-log {
		contain: size;
		min-height: 0;
		--log-bg: hsl(var(--card));
		--log-fg: hsl(var(--foreground));
		--log-muted: hsl(var(--muted-foreground));
		--log-border: hsl(var(--border));
		--log-accent: hsl(var(--primary));
	}

	.latest-posts ul,
	.log-list {
		display: flex;
		flex: 1;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.log-list {
		min-height: 0;
		overflow-y: auto;
		scrollbar-color: hsl(var(--muted-foreground) / 0.35) transparent;
		scrollbar-width: thin;
	}

	.log-list::-webkit-scrollbar {
		width: 8px;
	}

	.log-list::-webkit-scrollbar-thumb {
		border: 2px solid transparent;
		border-radius: 999px;
		background: hsl(var(--muted-foreground) / 0.3);
		background-clip: padding-box;
	}

	.log-list::-webkit-scrollbar-track {
		background: transparent;
	}

	.latest-posts li {
		display: flex;
		flex: 1;
		border-top: 1px solid hsl(var(--border));
	}

	.log-list li {
		display: flex;
		flex: 0 0 auto;
	}

	.log-list li + li {
		border-top: 1px solid var(--log-border);
	}

	.latest-post {
		display: grid;
		flex: 1;
		grid-template-columns: 64px minmax(0, 1fr);
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem 0;
	}

	.latest-post-image-link {
		display: block;
	}

	.latest-post img {
		width: 64px;
		height: 64px;
		border: 1px solid hsl(var(--border));
		border-radius: 0;
		object-fit: cover;
		transition: border-color 0.16s ease;
	}

	.latest-post-body {
		display: grid;
		gap: 0.15rem;
		min-width: 0;
	}

	.latest-post-title {
		color: hsl(var(--foreground));
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 700;
		letter-spacing: -0.01em;
		line-height: 1.35;
		text-decoration: none;
		transition: color 0.16s ease;
	}

