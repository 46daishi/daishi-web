<script>
	const bio = document.querySelector<HTMLElement>('[data-typewriter]');
	const source = bio?.querySelector<HTMLElement>('[data-typewriter-source]');
	const target = bio?.querySelector<HTMLElement>('[data-typewriter-target]');

	if (bio && source && target) {
		const text = (source.textContent ?? '').replace(/\s+/g, ' ').trim();
		const characters = Array.from(text);
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let index = 0;

		const complete = () => {
			bio.classList.add('is-complete');
		};

		const typeNext = () => {
			if (index >= characters.length) {
				complete();
				return;
			}

			target.textContent += characters[index++];
			window.setTimeout(typeNext, 14);
		};

		if (reducedMotion) {
			target.textContent = text;
			complete();
		} else {
			window.setTimeout(typeNext, 180);
		}
	}
</script>
