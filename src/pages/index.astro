<script>
	const bio = document.querySelector<HTMLElement>('[data-typewriter]');
	const source = bio?.querySelector<HTMLElement>('[data-typewriter-source]');
	const target = bio?.querySelector<HTMLElement>('[data-typewriter-target]');

	if (bio && source && target) {
		const text = (source.textContent ?? '').replace(/\s+/g, ' ').trim();
		const characters = Array.from(text);
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		let index = 0;

		const complete = () => {
			bio.classList.add('is-complete');
		};

		const typeNext = () => {
			if (index >= characters.length) {
				complete();
				return;
			}

			target.textContent += characters[index++];
			window.setTimeout(typeNext, 14);
		};

		if (reducedMotion) {
			target.textContent = text;
			complete();
		} else {
			window.setTimeout(typeNext, 180);
		}
	}
</script>

<script>
	type LanyardActivity = {
		name: string;
		type: number;
		application_id?: string;
		details?: string | null;
		state?: string | null;
		created_at?: number;
		timestamps?: {
			start?: number;
			end?: number;
		};
		assets?: {
			large_image?: string | null;
			large_text?: string | null;
			small_image?: string | null;
			small_text?: string | null;
		};
	};

	type LanyardPresence = {
		success: boolean;
		data?: {
			discord_status: string;
			activities: LanyardActivity[];
			listening_to_spotify: boolean;
			spotify?: {
				song: string;
				artist: string;
				album: string;
				album_art_url: string;
				timestamps?: {
					start?: number;
					end?: number;
				};
			} | null;
		};
	};

	type WikidataSearchResult = {
		id: string;
		label: string;
		description?: string;
	};

	type WikidataEntity = {
		claims?: {
			P18?: Array<{
				mainsnak?: {
					datavalue?: {
						value?: string;
					};
				};
			}>;
		};
		sitelinks?: {
			enwiki?: {
				title?: string;
			};
		};
	};

	type WikidataSearchResponse = {
		search?: WikidataSearchResult[];
	};

	type WikipediaSummary = {
		description?: string;
		thumbnail?: {
			source?: string;
		};
	};

	type WikipediaSearchResponse = {
		query?: {
			search?: Array<{
				title: string;
				snippet: string;
			}>;
		};
	};

	const activityImageFallbacks: Record<string, string> = {
		'1266470168268378245': 'https://cdn2.steamgriddb.com/thumb/6fb0de15f0b5cf7c5062ed8d8271a488.jpg',
	};
	const gameArtworkCache = new Map<string, string | null>();

	const findGameArtwork = async (name: string): Promise<string | null> => {
		const cacheKey = name.trim().toLocaleLowerCase();
		if (gameArtworkCache.has(cacheKey)) return gameArtworkCache.get(cacheKey) ?? null;

		const searchUrl = new URL('https://www.wikidata.org/w/api.php');
		searchUrl.search = new URLSearchParams({
			action: 'wbsearchentities',
			search: name,
			language: 'en',
			format: 'json',
			origin: '*',
		}).toString();
		const searchResponse = await fetch(searchUrl, {
			signal: AbortSignal.timeout(5_000),
		});
		if (!searchResponse.ok) {
			throw new Error(`Wikidata search returned HTTP ${searchResponse.status}`);
		}
		const search = (await searchResponse.json()) as WikidataSearchResponse;
		const gameEntity = search.search?.find(
			(result) =>
				result.label.trim().toLocaleLowerCase() === cacheKey &&
				/\b(video game|game)\b/i.test(result.description ?? ''),
		);
		let articleTitle: string | undefined;
		if (gameEntity) {
			const entityResponse = await fetch(
				`https://www.wikidata.org/wiki/Special:EntityData/${encodeURIComponent(gameEntity.id)}.json`,
				{ signal: AbortSignal.timeout(5_000) },
			);
			if (!entityResponse.ok) {
				throw new Error(`Wikidata entity lookup returned HTTP ${entityResponse.status}`);
			}
			const entityPayload = (await entityResponse.json()) as {
				entities?: Record<string, WikidataEntity>;
			};
			const entity = entityPayload.entities?.[gameEntity.id];
			const imageFile = entity?.claims?.P18?.[0]?.mainsnak?.datavalue?.value;
			if (imageFile) {
				const imageUrl = `https://commons.wikimedia.org/wiki/Special:FilePath/${encodeURIComponent(imageFile)}?width=512`;
				gameArtworkCache.set(cacheKey, imageUrl);
				return imageUrl;
			}
			articleTitle = entity?.sitelinks?.enwiki?.title;
		}

		if (articleTitle) {
			const summaryResponse = await fetch(
				`https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(articleTitle.replaceAll(' ', '_'))}`,
				{ signal: AbortSignal.timeout(5_000) },
			);
			if (summaryResponse.ok) {
				const summary = (await summaryResponse.json()) as WikipediaSummary;
				if (
					/\b(video game|game)\b/i.test(summary.description ?? '') &&
					summary.thumbnail?.source
				) {
					gameArtworkCache.set(cacheKey, summary.thumbnail.source);
					return summary.thumbnail.source;
				}
			} else if (summaryResponse.status !== 404) {
				throw new Error(`Wikipedia summary returned HTTP ${summaryResponse.status}`);
			}
		}

		const wikipediaSearchUrl = new URL('https://en.wikipedia.org/w/api.php');
		wikipediaSearchUrl.search = new URLSearchParams({
			action: 'query',
			list: 'search',
			srsearch: name,
			srlimit: '5',
			format: 'json',
			origin: '*',
		}).toString();
		const wikipediaSearchResponse = await fetch(wikipediaSearchUrl, {
			signal: AbortSignal.timeout(5_000),
		});
		if (!wikipediaSearchResponse.ok) {
			throw new Error(`Wikipedia search returned HTTP ${wikipediaSearchResponse.status}`);
		}
		const wikipediaSearch = (await wikipediaSearchResponse.json()) as WikipediaSearchResponse;
		for (const result of wikipediaSearch.query?.search ?? []) {
			if (!/\b(video game|visual novel|game)\b/i.test(result.snippet.replace(/<[^>]*>/g, ''))) {
				continue;
			}
			const summaryResponse = await fetch(
				`https://en.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(result.title.replaceAll(' ', '_'))}`,
				{ signal: AbortSignal.timeout(5_000) },
			);
			if (summaryResponse.status === 404) continue;
			if (!summaryResponse.ok) {
				throw new Error(`Wikipedia summary returned HTTP ${summaryResponse.status}`);
			}
			const summary = (await summaryResponse.json()) as WikipediaSummary;
			if (
				/\b(video game|visual novel|game)\b/i.test(summary.description ?? '') &&
				summary.thumbnail?.source
			) {
				gameArtworkCache.set(cacheKey, summary.thumbnail.source);
				return summary.thumbnail.source;
			}
		}

		gameArtworkCache.set(cacheKey, null);
		return null;
	};

	const presence = document.querySelector<HTMLElement>('[data-lanyard-presence]');

	if (presence) {
		const endpoint = presence.dataset.endpoint;
		const indicator = presence.querySelector<HTMLElement>('[data-presence-indicator]');
		const statusLabel = presence.querySelector<HTMLElement>('[data-presence-status]');
		const compactStatusMedia = window.matchMedia('(max-width: 719px)');
		const kindLabel = presence.querySelector<HTMLElement>('[data-presence-kind]');
		const kindDivider = presence.querySelector<HTMLElement>('[data-presence-kind-divider]');
		const nameLabel = presence.querySelector<HTMLElement>('[data-presence-name]');
		const detailLabel = presence.querySelector<HTMLElement>('[data-presence-detail]');
		const stateLabel = presence.querySelector<HTMLElement>('[data-presence-state]');
		const art = presence.querySelector<HTMLElement>('[data-presence-art]');
		const image = presence.querySelector<HTMLImageElement>('[data-presence-image]');
		const placeholder = presence.querySelector<HTMLElement>('[data-presence-placeholder]');
		const smallArt = presence.querySelector<HTMLElement>('[data-presence-small-art]');
		const smallImage = presence.querySelector<HTMLImageElement>('[data-presence-small-image]');
		const largeTarget = presence.querySelector<HTMLElement>('[data-presence-large-target]');
		const smallTarget = presence.querySelector<HTMLElement>('[data-presence-small-target]');
		const largeTooltip = presence.querySelector<HTMLElement>('[data-presence-large-tooltip]');
		const smallTooltip = presence.querySelector<HTMLElement>('[data-presence-small-tooltip]');
		const elapsed = presence.querySelector<HTMLTimeElement>('[data-presence-elapsed]');
		let elapsedStartedAt: number | null = null;

		const updateStatusLabel = () => {
			if (!statusLabel) return;
			const status = statusLabel.dataset.status;
			statusLabel.textContent =
				status === 'dnd'
					? compactStatusMedia.matches
						? 'DND'
						: 'Do not disturb'
					: status === 'idle'
						? 'Idle'
						: status === 'online'
							? 'Online'
							: status === 'offline'
								? 'Offline'
								: compactStatusMedia.matches
									? 'Checking'
									: 'Checking Discord';
		};

		compactStatusMedia.addEventListener('change', updateStatusLabel);
		updateStatusLabel();

		const setOptionalText = (element: HTMLElement | null, value?: string | null) => {
			if (!element) return;
			element.textContent = value ?? '';
			element.hidden = !value;
		};

		const setTooltip = (
			tooltip: HTMLElement | null,
			target: HTMLElement | null,
			value?: string | null,
		) => {
			if (tooltip) {
				tooltip.textContent = value ?? '';
				tooltip.hidden = !value;
			}
			if (target) {
				if (value) target.setAttribute('aria-label', value);
				else target.removeAttribute('aria-label');
			}
		};

		const getAssetUrl = (asset?: string | null, applicationId?: string) => {
			if (!asset) return '';
			if (/^https?:\/\//.test(asset)) return asset;
			if (asset.startsWith('mp:external/')) {
				return `https://media.discordapp.net/${asset.slice(3)}`;
			}
			return applicationId
				? `https://cdn.discordapp.com/app-assets/${applicationId}/${asset}.png`
				: '';
		};

		const updateElapsed = () => {
			if (!elapsed) return;
			if (elapsedStartedAt === null) {
				elapsed.textContent = '';
				elapsed.removeAttribute('datetime');
				elapsed.hidden = true;
				return;
			}
			const totalSeconds = Math.max(0, Math.floor((Date.now() - elapsedStartedAt) / 1000));
			const hours = Math.floor(totalSeconds / 3600);
			const minutes = Math.floor((totalSeconds % 3600) / 60);
			const seconds = totalSeconds % 60;
			elapsed.textContent =
				hours > 0
					? `${hours}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`
					: `${minutes}:${String(seconds).padStart(2, '0')}`;
			elapsed.dateTime = `PT${totalSeconds}S`;
			elapsed.hidden = false;
		};

		const renderPresence = async (data: NonNullable<LanyardPresence['data']>) => {
			const status = data.discord_status;
			if (indicator) indicator.dataset.status = status;
			if (statusLabel) {
				statusLabel.dataset.status = status;
				updateStatusLabel();
			}

			const spotify = data.listening_to_spotify ? data.spotify : null;
			const supportedActivities = data.activities.filter(
				(item) => item.type === 0 || item.type === 2 || item.type === 3 || item.type === 5,
			);
			const activity =
				supportedActivities.find(
					(item) =>
						item.type === 0 &&
						(item.assets?.large_image || item.assets?.small_image),
				) ??
				supportedActivities.find((item) => item.type === 0) ??
				supportedActivities.find((item) => item.name !== 'Spotify') ??
				null;
			const spotifyActivity = data.activities.find((item) => item.name === 'Spotify');
			const activeActivity = spotify ? spotifyActivity : activity;
			elapsedStartedAt = spotify
				? spotify.timestamps?.start ?? spotifyActivity?.created_at ?? null
				: activity?.timestamps?.start ?? activity?.created_at ?? null;
			updateElapsed();

			if (spotify) {
				if (kindLabel) {
					kindLabel.textContent = 'Listening to Spotify';
					kindLabel.hidden = false;
				}
				if (kindDivider) kindDivider.hidden = false;
				if (nameLabel) nameLabel.textContent = spotify.song;
				setOptionalText(detailLabel, `by ${spotify.artist}`);
				setOptionalText(stateLabel, spotify.album);
			} else if (activity) {
				if (kindLabel) {
					kindLabel.textContent =
						activity.type === 3
							? 'Watching'
							: activity.type === 2
								? 'Listening to'
								: activity.type === 5
									? 'Competing in'
									: 'Playing';
					kindLabel.hidden = false;
				}
				if (kindDivider) kindDivider.hidden = false;
				if (nameLabel) nameLabel.textContent = activity.name;
				setOptionalText(detailLabel, activity.details);
				setOptionalText(stateLabel, activity.state);
			} else {
				if (kindLabel) {
					kindLabel.textContent = '';
					kindLabel.hidden = true;
				}
				if (kindDivider) kindDivider.hidden = true;
				if (nameLabel) {
					nameLabel.textContent =
						status === 'offline' ? 'Not online right now' : 'Not playing anything right now';
				}
				setOptionalText(detailLabel);
				setOptionalText(stateLabel);
			}

			let imageUrl =
				(spotify ? spotify.album_art_url : '') ||
				getAssetUrl(activeActivity?.assets?.large_image, activeActivity?.application_id) ||
				(activity?.application_id
					? activityImageFallbacks[activity.application_id] ?? ''
					: '');
			if (!imageUrl && activity) {
				try {
					imageUrl = (await findGameArtwork(activity.name)) ?? '';
				} catch (error) {
					console.warn(`Unable to find catalog artwork for "${activity.name}".`, error);
				}
			}
			const smallImageUrl = getAssetUrl(
				activeActivity?.assets?.small_image,
				activeActivity?.application_id,
			);
			setTooltip(
				largeTooltip,
				largeTarget,
				imageUrl
					? (activeActivity?.assets?.large_text ?? (spotify ? spotify.album : activeActivity?.name))
					: '',
			);
			setTooltip(
				smallTooltip,
				smallTarget,
				smallImageUrl
					? (activeActivity?.assets?.small_text ?? activeActivity?.name)
					: '',
			);

			if (image && art && placeholder) {
				image.onerror = () => {
					art.hidden = true;
					placeholder.hidden = false;
				};
				if (imageUrl) {
					image.src = imageUrl;
					art.hidden = false;
					placeholder.hidden = true;
				} else {
					image.removeAttribute('src');
					art.hidden = true;
					placeholder.hidden = false;
				}
			}

			if (smallImage && smallArt) {
				smallImage.onerror = () => {
					smallArt.hidden = true;
				};
				if (smallImageUrl) {
					smallImage.src = smallImageUrl;
					smallArt.hidden = false;
				} else {
					smallImage.removeAttribute('src');
					smallArt.hidden = true;
				}
			}
		};

		const updatePresence = async () => {
			if (!endpoint) return;
			try {
				const response = await fetch(endpoint, { cache: 'no-store' });
				if (!response.ok) throw new Error(`Lanyard returned HTTP ${response.status}`);
				const result = (await response.json()) as LanyardPresence;
				if (!result.success || !result.data) throw new Error('Lanyard returned no presence data');
				await renderPresence(result.data);
			} catch (error) {
				if (statusLabel) statusLabel.textContent = 'Discord status unavailable';
				if (kindLabel) kindLabel.textContent = 'Retrying';
				if (nameLabel) nameLabel.textContent = 'Could not load activity';
				setOptionalText(detailLabel);
				setOptionalText(stateLabel);
				elapsedStartedAt = null;
				if (elapsed) {
					elapsed.textContent = '';
					elapsed.removeAttribute('datetime');
					elapsed.hidden = true;
				}
				console.error('Unable to fetch Discord presence from Lanyard.', error);
			}
		};

		void updatePresence();
		window.setInterval(updatePresence, 60_000);
		window.setInterval(updateElapsed, 1_000);
	}
</script>
