---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import BlogPostPreview from '../../components/BlogPostPreview.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags.map((tag) => tag.toLowerCase())))].sort(
	(a, b) => a.localeCompare(b),
);
const linkedProjectIds = new Set(
	posts.flatMap((post) => (post.data.project ? [post.data.project] : [])),
);
const projectFilters = (await getCollection('projects'))
	.filter((project) => linkedProjectIds.has(project.id))
	.sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-intro">
				<span class="section-kicker" lang="ja">日記</span>
				<h1>blog</h1>
			</header>

			<div class="filter-panel">
				<nav class="filter-row" aria-label="Filter posts by tag">
					<span class="filter-label">
						<span class="filter-label-icon" aria-hidden="true">{'\uf292'}</span>
						tag
					</span>
					<div class="filter-options">
						<button class="tag-filter is-active" type="button" data-tag-filter="all" aria-pressed="true">
							all
						</button>
						{tags.map((tag) => (
							<button class="tag-filter" type="button" data-tag-filter={tag} aria-pressed="false">
								#{tag.trim().replace(/\s+/g, '-')}
							</button>
						))}
					</div>
				</nav>
				<nav class="filter-row" aria-label="Filter posts by project">
					<span class="filter-label">
						<span class="filter-label-icon" aria-hidden="true">{'\uf005'}</span>
						project
					</span>
					<div class="filter-options">
						<button class="tag-filter is-active" type="button" data-project-filter="all" aria-pressed="true">
							all
						</button>
						{projectFilters.map((project) => (
							<button
								class="tag-filter"
								type="button"
								data-project-filter={project.id}
								aria-pressed="false"
							>
								<Image
									class="project-filter-icon"
									src={project.data.icon}
									alt=""
									width={20}
									height={20}
								/>
								{project.data.title}
							</button>
						))}
					</div>
				</nav>
			</div>
			<p class="filter-count" data-filter-count aria-live="polite">
				{posts.length} {posts.length === 1 ? 'post' : 'posts'}
			</p>

			<ul class="post-grid">
				{posts.map((post) => (
					<li
						class="post-item"
						data-post-tags={JSON.stringify(post.data.tags.map((tag) => tag.toLowerCase()))}
						data-post-project={post.data.project ?? ''}
					>
						<article class="post-card">
							<a class="post-card-link" href={`/blog/${post.id}/`}>
								{post.data.heroImage && (
									<Image
										class="post-image"
										width={720}
										height={360}
										src={post.data.heroImage}
										alt=""
									/>
								)}
								{!post.data.heroImage && (
									<div class="post-preview" aria-hidden="true">
										<BlogPostPreview postId={post.id} title={post.data.title} />
									</div>
								)}
								<div class="post-card-body">
									<FormattedDate date={post.data.pubDate} format="ja" />
									<h2 class="post-title">{post.data.title}</h2>
									<p class="post-description">{post.data.description}</p>
								</div>
							</a>
							{post.data.tags.length > 0 && (
								<ul class="post-tags" aria-label={`${post.data.title} tags`}>
									{post.data.tags.map((tag) => (
										<li>#{tag.trim().replace(/\s+/g, '-')}</li>
									))}
								</ul>
							)}
						</article>
					</li>
				))}
			</ul>
			<p class="empty-state" data-empty-state hidden>No posts match these filters.</p>
		</main>
		<Footer />
	</body>
</html>

<script>
	const tagButtons = [...document.querySelectorAll('[data-tag-filter]')];
	const projectButtons = [...document.querySelectorAll('[data-project-filter]')];
	const posts = [...document.querySelectorAll('[data-post-tags]')];
	const count = document.querySelector('[data-filter-count]');
	const emptyState = document.querySelector('[data-empty-state]');
	const tagsByPost = new Map(posts.map((post) => [post, JSON.parse(post.dataset.postTags)]));
	let selectedTag = 'all';
	let selectedProject = 'all';

	const updatePressed = (buttons, selected, filterAttribute) => {
		buttons.forEach((button) => {
			const active = button.getAttribute(filterAttribute) === selected;
			button.setAttribute('aria-pressed', String(active));
			button.classList.toggle('is-active', active);
		});
	};

	const updatePosts = () => {
		let visibleCount = 0;

		posts.forEach((post) => {
			const postTags = tagsByPost.get(post);
			const matchesTag = selectedTag === 'all' || postTags.includes(selectedTag);
			const matchesProject =
				selectedProject === 'all' || post.dataset.postProject === selectedProject;
			const visible = matchesTag && matchesProject;
			post.hidden = !visible;
			visibleCount += Number(visible);
		});

		count.textContent = `${visibleCount} ${visibleCount === 1 ? 'post' : 'posts'}`;
		emptyState.hidden = visibleCount > 0;
	};

	tagButtons.forEach((button) => {
		button.addEventListener('click', () => {
			selectedTag = button.dataset.tagFilter;
			updatePressed(tagButtons, selectedTag, 'data-tag-filter');
			updatePosts();
		});
	});

	projectButtons.forEach((button) => {
		button.addEventListener('click', () => {
			selectedProject = button.dataset.projectFilter;
			updatePressed(projectButtons, selectedProject, 'data-project-filter');
			updatePosts();
		});
	});
</script>

<style>
	.page-intro {
		margin-bottom: 2rem;
	}

	.page-intro h1 {
		margin: 0.05rem 0 0.4rem;
	}

	.page-intro p {
		margin: 0;
		color: hsl(var(--foreground) / 0.82);
		font-family: var(--font-sazanami);
		font-size: 1.05rem;
	}

	.filter-panel {
		border-top: 1px solid hsl(var(--border));
		border-bottom: 1px solid hsl(var(--border));
	}

	.filter-row {
		display: flex;
		align-items: baseline;
		gap: 0.65rem 1rem;
		padding: 0.75rem 0;
	}

	.filter-row + .filter-row {
		border-top: 1px solid hsl(var(--border));
	}

	.filter-label {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		flex: 0 0 auto;
		color: hsl(var(--muted-foreground));
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.filter-label-icon {
		font-family: var(--font-symbols);
		font-size: 0.85rem;
		line-height: 1;
	}

	.filter-options {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.tag-filter {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.2rem 0.5rem;
		border: 1px solid transparent;
		border-radius: var(--radius);
		background: transparent;
		color: hsl(var(--foreground) / 0.78);
		font: inherit;
		font-size: 0.78rem;
		cursor: pointer;
		transition:
			color 0.16s ease,
			border-color 0.16s ease,
			background-color 0.16s ease;
	}

	.project-filter-icon {
		width: 1rem;
		height: 1rem;
		margin: 0;
		border: 0;
		border-radius: 0.2rem;
		object-fit: cover;
	}

	.tag-filter:hover,
	.tag-filter:focus-visible {
		color: hsl(var(--primary));
	}

	.tag-filter.is-active {
		border-color: hsl(var(--primary) / 0.25);
		background: hsl(var(--primary) / 0.08);
		color: hsl(var(--primary));
	}

	.filter-count {
		margin: 0.65rem 0 1rem;
		color: hsl(var(--muted-foreground));
		font-size: 0.75rem;
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-item[hidden] {
		display: none;
	}

	.post-card {
		height: 100%;
		overflow: hidden;
		border: 1px solid hsl(var(--border));
		border-radius: 0.75rem;
		transition: border-color 0.16s ease;
	}

	.post-card:hover,
	.post-card:focus-within {
		border-color: hsl(var(--primary) / 0.45);
	}

	.post-card-link {
		display: block;
		color: inherit;
		text-decoration: none;
	}

	.post-image {
		display: block;
		width: 100%;
		aspect-ratio: 2 / 1;
		margin: 0;
		border: 0;
		border-bottom: 1px solid hsl(var(--border));
		border-radius: 0;
		object-fit: cover;
		object-position: center top;
		transition: opacity 0.16s ease;
	}

	.post-preview {
		position: relative;
		aspect-ratio: 2 / 1;
		overflow: hidden;
		border-bottom: 1px solid hsl(var(--border));
	}

	.post-card:hover .post-image,
	.post-card:focus-within .post-image {
		opacity: 0.88;
	}

	.post-card-body {
		padding: 0.85rem 1rem 0.6rem;
	}

	.post-card-body :global(time) {
		color: hsl(var(--foreground) / 0.78);
		font-size: 0.75rem;
	}

	.post-title {
		margin: 0.25rem 0 0.35rem;
		font-family: var(--font-sazanami);
		font-size: 1.2rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.3;
		transition: color 0.16s ease;
	}

	.post-card:hover .post-title,
	.post-card:focus-within .post-title {
		color: hsl(var(--primary));
	}

	.post-description {
		margin: 0;
		color: hsl(var(--foreground) / 0.8);
		font-family: var(--font-sazanami);
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.2rem 0.65rem;
		margin: 0;
		padding: 0 1rem 0.9rem;
		list-style: none;
		color: hsl(var(--foreground));
		font-size: 0.78rem;
		font-weight: 600;
	}

	.empty-state {
		padding: 2rem 0;
		color: hsl(var(--muted-foreground));
		text-align: center;
	}

	@media (max-width: 640px) {
		.filter-row {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.35rem;
		}

		.post-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.tag-filter,
		.post-card,
		.post-image,
		.post-title {
			transition: none;
		}
	}
</style>
