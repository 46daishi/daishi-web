---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import mediaPlaceholder1 from '../assets/media/ef.jpg';
import mediaPlaceholder2 from '../assets/media/sg.jpg';
import mediaPlaceholder3 from '../assets/media/rgd.jpg';
import mediaPlaceholder4 from '../assets/media/umineko.jpg';
import mediaPlaceholder5 from '../assets/media/cote.webp';
import continueCursorSprite from '../assets/icons/cursor1.bmp?url';
import typingCursorSprite from '../assets/icons/cursor0.bmp?url';
import soulGardenIcon from '../assets/icons/soul-garden.png';
import springPoemsIcon from '../assets/icons/spring-poems.png';
import tomoyoIcon from '../assets/icons/tomoyo.png';
import interestJapanese from '../assets/interests/japanese.png';
import interestLinux from '../assets/interests/programming.webp';
import interestMahjong from '../assets/interests/mahjong.png';
import interestProgramming from '../assets/interests/linux.gif';
import interestVisualNovels from '../assets/interests/visual-novels.png';
import interestWriting from '../assets/interests/writing.gif';
import pfp from '../assets/pfp.jpg';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import HanaDivider from '../components/HanaDivider.astro';
import Header from '../components/Header.astro';
import ProfileFacts from '../components/ProfileFacts.astro';
import { SITE_TITLE } from '../consts';

const currentlyInto = [
	{ title: 'Final Fantasy VII Remake', icon: 'https://cdn2.steamgriddb.com/icon_thumb/d6cf4da5ced8580c991e16fb54faa1b6.png' },
	{ title: 'Baldur\'s Gate 3', icon: 'https://cdn2.steamgriddb.com/icon/0cd60efb5578cd967c3c23894f305800/32/256x256.png' },
	{ title: 'Yosuga no Sora', icon: 'https://cdn2.steamgriddb.com/icon/f1ce00c04b55f6c2d825498cc86a296e/8/32x32.png' },
	{ title: 'The House in Fata Morgana', icon: 'https://i.pinimg.com/736x/3e/4d/7f/3e4d7f9c31407cc18806d635592bbc6a.jpg' },
	{ title: 'I/O revision II', icon: 'https://t.vndb.org/cv/72/154272.jpg' },
];

const favoriteMedia = [
	{ title: 'ef - a fairy tale of the two', type: 'Visual Novel', cover: mediaPlaceholder1 },
	{ title: 'STEINS;GATE', type: 'Visual Novel', cover: mediaPlaceholder2 },
	{ title: 'Rose Guns Days', type: 'Visual Novel', cover: mediaPlaceholder3 },
	{ title: 'Umineko no Naku Koro ni', type: 'Visual Novel', cover: mediaPlaceholder4 },
	{ title: 'Classroom of the Elite', type: 'Light Novel', cover: mediaPlaceholder5 },
];

type BioToken =
	| { type: 'text'; value: string }
	| { type: 'link'; href: string; label: string; icon: ImageMetadata };

const bioText = (value: string): BioToken => ({ type: 'text', value });
const bioLink = (href: string, label: string, icon: ImageMetadata): BioToken => ({
	type: 'link',
	href,
	label,
	icon,
});

// Edit the bio here. The ghost, live targets, and screen-reader sources are
// generated from this list, so the copies can't drift apart.
const bioParagraphs: BioToken[][] = [
	[bioText("Hi, I am Dai, a writer and developer from Poland, currently studying computer science.")],
	[
		bioText(
			'My biggest dream is to bring my original series, Hoshi no Keikyo (星の携挙), to life. It will span multiple entries, from visual novels like ',
		),
		bioLink('/projects/spring-poems/', 'Spring Poems', springPoemsIcon),
		bioText(' to light novels like '),
		bioLink('/projects/soul-garden/', 'Soul Garden', soulGardenIcon),
	],
	[bioText("I love a wide range of series, including When They Cry, SciAdv, Persona, Re:Zero, and Death Note, to name just a few.")],
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`about | ${SITE_TITLE}`}
			description="A little about my interests and favourite media!"
		/>
	</head>
	<body>
		<Header />
		<main class="about-page">
			<section class="about-intro" aria-labelledby="about-heading">
				<div class="about-side">
					<figure class="about-portrait">
						<Image src={pfp} alt="daishi's profile picture" width={360} height={360} />
						<figcaption>
							pfp source <a href="https://x.com/nngw_000" target="_blank" rel="noreferrer">@nngw_000</a>
						</figcaption>
					</figure>

					<nav class="profile-links" aria-label="Media profiles">
						<a href="https://vndb.org/u325493" target="_blank" rel="noreferrer" aria-label="VNDB profile">
							<span class="sr-only">VNDB</span>
							<img src="/icons/vndb.ico" alt="" width="16" height="16" />
						</a>
						<a href="https://anilist.co/user/46dai/" target="_blank" rel="noreferrer" aria-label="AniList profile">
							<span class="sr-only">AniList</span>
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path
									fill="currentColor"
									d="M24 17.53v2.421c0 .71-.391 1.101-1.1 1.101h-5l-.057-.165L11.84 3.736c.106-.502.46-.788 1.053-.788h2.422c.71 0 1.1.391 1.1 1.1v12.38H22.9c.71 0 1.1.392 1.1 1.101zM11.034 2.947l6.337 18.104h-4.918l-1.052-3.131H6.019l-1.077 3.131H0L6.361 2.948h4.673zm-.66 10.96-1.69-5.014-1.541 5.015h3.23z"
								/>
							</svg>
						</a>
						<a href="https://steamcommunity.com/id/46dai/" target="_blank" rel="noreferrer" aria-label="Steam profile">
							<span class="sr-only">Steam</span>
							<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
								<path
									fill="currentColor"
									d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z"
								/>
							</svg>
						</a>
					</nav>

					<ProfileFacts />
				</div>

				<div class="about-copy">
					<header class="about-heading">
						<span class="section-kicker" lang="ja">自己紹介</span>
						<h1 id="about-heading">46<span>dai</span></h1>
					</header>
					<div class="about-bio" data-typewriter>
						<div class="about-bio-ghost" aria-hidden="true">
							{bioParagraphs.map((tokens, index) => (
								<p class="about-lead">
									{tokens.map((token) =>
										token.type === 'text' ? (
											token.value
										) : (
											<a href={token.href} class="link-with-icon"><Image class="link-icon" src={token.icon} alt="" width={48} height={48} />{token.label}</a>
										)
									)}
									{index === bioParagraphs.length - 1 && <span class="about-bio-cursor-space"></span>}
								</p>
							))}
						</div>
						<div class="about-bio-live">
							{bioParagraphs.map((_, index) => (
								<p class="about-lead">
									<span aria-hidden="true" data-typewriter-target></span>
									{index === bioParagraphs.length - 1 && (
										<a
											class="about-bio-cursor"
											href="#interests"
											aria-label="Continue to interests"
											style={`--cursor-sprite: url(${continueCursorSprite})`}
										></a>
									)}
								</p>
							))}
						</div>
						<span
							class="about-bio-type-cursor"
							aria-hidden="true"
							style={`--typing-cursor-sprite: url(${typingCursorSprite})`}
						></span>
						{bioParagraphs.map((tokens) => (
							<span class="sr-only" data-typewriter-source>
								{tokens.map((token) =>
									token.type === 'text' ? (
										token.value
									) : (
										<a href={token.href} class="link-with-icon" tabindex="-1"><Image class="link-icon" src={token.icon} alt="" width={48} height={48} />{token.label}</a>
									)
								)}
							</span>
						))}
					</div>
				</div>
			</section>

			<HanaDivider />

			<section class="interests" id="interests" aria-labelledby="interests-heading">
				<header class="section-heading">
					<div>
						<span class="section-kicker" lang="ja">趣味</span>
						<h2 id="interests-heading">interests</h2>
					</div>
				</header>

				<ul class="interest-grid">
					<li>
						<span class="interest-thumb" aria-hidden="true">
							<Image src={interestVisualNovels} alt="" width={256} height={341} loading="lazy" />
						</span>
						<div class="interest-body">
							<h3>visual novels</h3>
							<p>I enjoy visual novels as both a reader and a writer and have been reading them since 2020.</p>
						</div>
					</li>
					<li>
						<span class="interest-thumb" aria-hidden="true">
							<Image src={interestJapanese} alt="" width={256} height={341} loading="lazy" />
						</span>
						<div class="interest-body">
							<h3>日本語</h3>
							<p>I'm studying Japanese and working toward getting more comfortable with it, mainly through immersion via my app <a href="/projects/tomoyo/" class="link-with-icon"><Image class="link-icon" src={tomoyoIcon} alt="" width={48} height={48} />tomoyo</a>.</p>
						</div>
					</li>
					<li>
						<span class="interest-thumb" aria-hidden="true">
							<Image src={interestWriting} alt="" width={256} height={341} loading="lazy" />
						</span>
						<div class="interest-body">
							<h3>writing</h3>
							<p>I write both fiction and non-fiction, with a particular focus on visual novels.</p>
						</div>
					</li>
					<li>
						<span class="interest-thumb" aria-hidden="true">
							<Image src={interestProgramming} alt="" width={256} height={341} loading="lazy" />
						</span>
						<div class="interest-body">
							<h3>programming &amp; app development</h3>
							<p>In my free time I build apps and tools, and I also program for VNs in ONScripter.</p>
						</div>
					</li>
					<li>
						<span class="interest-thumb" aria-hidden="true">
							<Image src={interestMahjong} alt="" width={256} height={341} loading="lazy" />
						</span>
						<div class="interest-body">
							<h3>riichi mahjong</h3>
							<p>I started playing in April 2025 and peaked at Master 2 on MJS. Feel free to add me: 141399271!</p>
						</div>
					</li>
					<li>
						<span class="interest-thumb" aria-hidden="true">
							<Image src={interestLinux} alt="" width={256} height={341} loading="lazy" />
						</span>
						<div class="interest-body">
							<h3>linux</h3>
							<p>I like tinkering with Linux and have been daily driving it for more than a year.</p>
						</div>
					</li>
				</ul>
			</section>

			<section class="currently" aria-labelledby="currently-heading">
				<header class="section-heading">
					<div>
						<span class="section-kicker" lang="ja">現在</span>
						<h2 id="currently-heading">currently reading &amp; playing</h2>
					</div>
				</header>

				<ul class="currently-row">
					{currentlyInto.map((item) => (
						<li>
							<span class="currently-icon">
								<img
									src={item.icon}
									alt=""
									width="64"
									height="64"
									loading="lazy"
									decoding="async"
								/>
							</span>
							<span class="currently-name">{item.title}</span>
						</li>
					))}
				</ul>
			</section>

			<section class="favorite-media" aria-labelledby="favorite-media-heading">
				<header class="section-heading">
					<div>
						<span class="section-kicker" lang="ja">お気に入り</span>
						<h2 id="favorite-media-heading">favorite media</h2>
					</div>
				</header>

				<ul class="favorite-media-grid">
					{favoriteMedia.map((media) => (
						<li>
							<article class="media-card">
								<div class="media-cover">
									<Image src={media.cover} alt="" width={320} height={480} />
								</div>
								<h3>{media.title}</h3>
								<p>{media.type}</p>
							</article>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-page {
		max-width: 932px;
	}

	.about-heading {
		margin-bottom: 0.75rem;
		font-family: var(--font-mono);
	}

	.about-heading h1 {
		margin: 0;
		font-size: clamp(2.5rem, 6vw, 3.5rem);
		line-height: 1;
		letter-spacing: -0.07em;
	}

	.about-heading h1 span {
		color: hsl(var(--primary));
	}

	.about-intro {
		display: grid;
		grid-template-columns: clamp(7.5rem, 16vw, 11rem) minmax(0, 1fr);
		align-items: start;
		gap: 2rem;
	}

	.about-side {
		min-width: 0;
	}

	.about-portrait {
		position: relative;
		overflow: hidden;
		margin: 0;
		border-radius: 0.75rem;
	}

	.about-portrait :global(img) {
		display: block;
		width: 100%;
		aspect-ratio: 1;
		border: 0;
		border-radius: inherit;
		object-fit: cover;
	}

	.about-portrait figcaption {
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		margin: 0;
		padding: 1.5rem 0.35rem 0.35rem;
		background: linear-gradient(180deg, transparent, rgb(0 0 0 / 0.78));
		color: rgb(255 255 255 / 0.85);
		font-size: 0.65rem;
		line-height: 1.4;
		text-align: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.16s ease;
	}

	.about-portrait:hover figcaption,
	.about-portrait:focus-within figcaption {
		opacity: 1;
		pointer-events: auto;
	}

	.about-portrait figcaption a {
		color: inherit;
	}

	.about-copy {
		color: hsl(var(--foreground) / 0.88);
		font-family: var(--font-sazanami);
		font-size: 1.05rem;
		line-height: 1.75;
	}

	.about-copy p {
		margin: 0 0 0.85rem;
	}

	.about-copy .about-lead {
		margin-bottom: 0.5rem;
		color: hsl(var(--foreground));
		font-size: 1.12rem;
		font-weight: 400;
		line-height: 1.65;
	}

	:global(:root[data-theme='dark']) .about-copy .about-lead {
		color: #fff;
	}

	.about-bio {
		position: relative;
		max-width: 36rem;
	}

	:global(html.js) .about-bio-ghost {
		visibility: hidden;
	}

	.about-bio-cursor-space {
		display: inline-block;
		width: calc(21px + 0.4rem);
		height: 1px;
	}

	.about-bio-live {
		display: none;
	}

	:global(html.js) .about-bio-live {
		position: absolute;
		inset: 0;
		display: block;
	}

	.about-bio-type-cursor {
		position: absolute;
		z-index: 1;
		display: none;
		width: 16px;
		height: 16px;
		margin-left: 0.3rem;
		background-image: var(--typing-cursor-sprite);
		background-repeat: no-repeat;
		background-position: 0 0;
		background-size: 64px 16px;
		image-rendering: pixelated;
		pointer-events: none;
		animation: about-typing-cursor-frames 0.7s steps(4) infinite;
	}

	.about-bio-type-cursor.is-visible {
		display: block;
	}

	.about-bio-cursor {
		display: none;
		width: 21px;
		height: 18px;
		margin-left: 0.4rem;
		vertical-align: -0.18em;
		background-image: var(--cursor-sprite);
		background-repeat: no-repeat;
		background-position: 0 0;
		background-size: 84px 18px;
		image-rendering: pixelated;
		text-decoration: none;
		animation: about-cursor-frames 0.7s steps(4) infinite;
	}

	:global(html.js) .about-bio.is-complete .about-bio-cursor {
		display: inline-block;
	}

	.about-page :global(.link-icon) {
		display: inline-block;
		width: 1.15em;
		height: 1.15em;
		margin-right: 0.32em;
		border: 0;
		border-radius: 0.22em;
		object-fit: cover;
		vertical-align: -0.2em;
	}

	.about-page :global(.link-with-icon) {
		white-space: nowrap;
	}

	@keyframes about-typing-cursor-frames {
		to {
			background-position-x: -64px;
		}
	}

	@keyframes about-cursor-frames {
		to {
			background-position-x: -84px;
		}
	}

	.interests {
		scroll-margin-top: 4.5rem;
	}

	.profile-links {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.1rem;
		margin-top: 0.4rem;
		color: hsl(var(--muted-foreground));
	}

	.profile-links a {
		display: grid;
		place-items: center;
		width: 30px;
		height: 30px;
		color: inherit;
		text-decoration: none;
		transition: color 0.16s ease;
	}

	.profile-links a:hover,
	.profile-links a:focus-visible {
		color: hsl(var(--primary));
	}

	.profile-links img,
	.profile-links svg {
		width: 16px;
		height: 16px;
		border: 0;
	}

	.profile-links img {
		image-rendering: pixelated;
	}

	.about-socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 1rem;
		margin-top: 1.1rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		font-weight: 600;
	}

	.section-heading {
		margin-bottom: 1rem;
	}

	.section-heading h2 {
		margin: 0;
		font-family: var(--font-sazanami);
	}

	.interest-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.interest-grid li {
		display: grid;
		grid-template-columns: clamp(6.5rem, 24%, 8rem) minmax(0, 1fr);
		align-items: stretch;
		overflow: hidden;
		border: 1px solid hsl(var(--border));
		border-radius: 0.75rem;
		background: hsl(var(--card));
		transition:
			transform 0.18s ease,
			border-color 0.18s ease,
			box-shadow 0.18s ease;
	}

	.interest-grid li:hover,
	.interest-grid li:focus-within {
		transform: translateY(-2px);
		border-color: hsl(var(--primary) / 0.45);
		box-shadow: 0 5px 16px hsl(var(--foreground) / 0.1);
	}

	.interest-thumb {
		position: relative;
		display: block;
		width: 100%;
		height: 100%;
		min-height: 7rem;
		background: hsl(var(--muted));
	}

	.interest-thumb :global(img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		object-fit: cover;
	}

	.interest-body {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 1rem 1.1rem;
	}

	.interest-grid h3 {
		margin: 0 0 0.4rem;
		font-family: var(--font-sazanami);
		font-size: 1.05rem;
	}

	.interest-grid p {
		margin: 0;
		color: hsl(var(--foreground) / 0.82);
		font-family: var(--font-sazanami);
		font-size: 0.92rem;
		line-height: 1.65;
	}

	.currently {
		margin-top: 2.5rem;
	}

	.currently-row {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.currently-row li {
		display: flex;
		flex-direction: column;
		align-items: center;
		min-width: 0;
		gap: 0.55rem;
		text-align: center;
	}

	.currently-icon {
		display: grid;
		place-items: center;
		width: 40px;
		height: 40px;
	}

	.currently-icon img {
		width: 30px;
		height: 30px;
		border: 0;
		object-fit: contain;
	}

	.currently-name {
		color: hsl(var(--foreground) / 0.85);
		font-family: var(--font-sazanami);
		font-size: 0.82rem;
		line-height: 1.35;
		text-wrap: balance;
	}

	@media (hover: hover) {
		.currently-row li {
			transition: transform 0.18s ease;
		}

		.currently-row li:hover {
			transform: translateY(-2px);
		}

		.currently-row li:hover .currently-name {
			color: hsl(var(--primary));
		}
	}

	.favorite-media {
		margin-top: 2.5rem;
	}

	.favorite-media-grid {
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.media-card {
		min-width: 0;
		transition: transform 0.18s ease;
	}

	.media-cover {
		transition:
			border-color 0.18s ease,
			box-shadow 0.18s ease;
	}

	@media (hover: hover) {
		.media-card:hover {
			transform: translateY(-2px);
		}

		.media-card:hover .media-cover {
			border-color: hsl(var(--primary) / 0.45);
			box-shadow: 0 5px 16px hsl(var(--foreground) / 0.12);
		}
	}

	.media-cover {
		aspect-ratio: 2 / 3;
		overflow: hidden;
		border: 1px solid hsl(var(--border));
		border-radius: 0.5rem;
		background: hsl(var(--muted));
	}

	.media-cover :global(img) {
		width: 100%;
		height: 100%;
		border: 0;
		object-fit: cover;
	}

	.media-card h3 {
		margin: 0.6rem 0 0.15rem;
		font-family: var(--font-sazanami);
		font-size: 0.95rem;
		line-height: 1.4;
	}

	.media-card p {
		margin: 0;
		color: hsl(var(--muted-foreground));
		font-size: 0.72rem;
		line-height: 1.5;
	}

	@media (max-width: 760px) {
		.favorite-media-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (max-width: 719px) {
		.interests {
			scroll-margin-top: 7rem;
		}
	}

	@media (max-width: 620px) {
		.about-intro {
			grid-template-columns: minmax(0, 7rem) minmax(0, 1fr);
			grid-template-areas:
				"portrait heading"
				"portrait facts"
				"links facts"
				"bio bio";
			column-gap: 1rem;
			row-gap: 0.75rem;
		}

		.about-side {
			display: contents;
		}

		.about-portrait {
			grid-area: portrait;
		}

		.about-copy {
			display: contents;
		}

		.about-heading {
			grid-area: heading;
			align-self: start;
			margin-bottom: 0;
		}

		.about-page :global(.profile-links) {
			grid-area: links;
			justify-content: flex-start;
			margin-top: 0;
		}

		.about-page :global(.profile-facts) {
			grid-area: facts;
			align-self: start;
			margin: 0;
		}

		.about-bio {
			grid-area: bio;
			max-width: none;
		}

		.interest-grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.interest-grid li {
			grid-template-columns: 6rem minmax(0, 1fr);
		}
	}

	@media (max-width: 560px) {
		.currently-row {
			gap: 0.5rem;
		}

		.currently-icon img {
			width: 26px;
			height: 26px;
		}

		.currently-name {
			font-size: 0.72rem;
		}
	}

	@media (max-width: 420px) {
		.favorite-media-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.about-portrait figcaption,
		.interest-grid li,
		.media-card,
		.media-cover,
		.currently-row li {
			transition: none;
		}

		.interest-grid li:hover,
		.interest-grid li:focus-within,
		.media-card:hover,
		.currently-row li:hover {
			transform: none;
		}

		.about-bio-type-cursor,
		.about-bio-cursor {
			animation: none;
		}
	}
</style>

<script>
	const bio = document.querySelector<HTMLElement>('[data-typewriter]');
	const targets = bio
		? [...bio.querySelectorAll<HTMLElement>('[data-typewriter-target]')]
		: [];
	const sources = bio
		? [...bio.querySelectorAll<HTMLElement>('[data-typewriter-source]')]
		: [];
	const typingCursor = bio?.querySelector<HTMLElement>('.about-bio-type-cursor') ?? null;

	if (bio && targets.length > 0 && targets.length === sources.length) {
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		type TypewriterStep =
			| { type: 'attach'; node: Node; parent: Node }
			| { type: 'char'; node: Text; char: string };

		const buildParagraph = (source: HTMLElement, target: HTMLElement) => {
			const steps: TypewriterStep[] = [];
			let lastWasSpace = true;

			const walk = (sourceNode: Node, parentNode: Node) => {
				sourceNode.childNodes.forEach((child) => {
					if (child.nodeType === Node.TEXT_NODE) {
						const text = document.createTextNode('');
						steps.push({ type: 'attach', node: text, parent: parentNode });

						for (const char of Array.from((child.textContent ?? '').replace(/\s+/g, ' '))) {
							if (char === ' ') {
								if (lastWasSpace) continue;
								lastWasSpace = true;
							} else {
								lastWasSpace = false;
							}

							steps.push({ type: 'char', node: text, char });
						}

						return;
					}

					if (child.nodeType !== Node.ELEMENT_NODE) return;

					const element = (child as Element).cloneNode(false) as Element;
					steps.push({ type: 'attach', node: element, parent: parentNode });
					walk(child, element);
				});
			};

			walk(source, target);

			while (steps.length > 0) {
				const last = steps[steps.length - 1];

				if (last.type === 'char' && last.char === ' ') {
					steps.pop();
				} else {
					break;
				}
			}

			return steps;
		};

		const paragraphs = sources.map((source, index) => buildParagraph(source, targets[index]));
		let paragraphIndex = 0;
		let stepIndex = 0;
		let lastCharRect: DOMRect | null = null;
		let skipCurrentParagraph = false;
		let waitingAtParagraphEnd = false;

		const charRect = (node: Text, offset: number) => {
			const range = document.createRange();
			range.setStart(node, offset);
			range.setEnd(node, offset + 1);

			const rects = Array.from(range.getClientRects());
			return rects.find((rect) => rect.height > 0) ?? null;
		};

		const showTypingCursor = (rect: DOMRect) => {
			if (!typingCursor) return;

			const bioRect = bio.getBoundingClientRect();
			const cursorWidth = 16;
			const maxLeft = Math.max(0, bio.clientWidth - cursorWidth);

			typingCursor.style.left = `${Math.min(rect.right - bioRect.left, maxLeft)}px`;
			typingCursor.style.top = `${rect.top - bioRect.top + (rect.height - 16) / 2}px`;
			typingCursor.classList.add('is-visible');
		};

		const hideTypingCursor = () => {
			typingCursor?.classList.remove('is-visible');
		};

		const complete = () => {
			hideTypingCursor();
			bio.classList.add('is-complete');

			bio.querySelectorAll('[data-typewriter-target]').forEach((target) => {
				target.removeAttribute('aria-hidden');
			});
			bio.querySelectorAll<HTMLAnchorElement>('.about-bio-live a[tabindex="-1"]').forEach((link) => {
				link.removeAttribute('tabindex');
			});
			sources.forEach((source) => {
				source.hidden = true;
			});
		};

		const typeNext = () => {
			const paragraph = paragraphs[paragraphIndex];

			if (!paragraph) {
				complete();
				return;
			}

			if (stepIndex >= paragraph.length) {
				const nextParagraph = paragraphIndex + 1;

				if (nextParagraph >= paragraphs.length) {
					complete();
					return;
				}

				const resume = () => {
					hideTypingCursor();
					waitingAtParagraphEnd = false;
					paragraphIndex = nextParagraph;
					stepIndex = 0;
					lastCharRect = null;
					typeNext();
				};

				if (lastCharRect) {
					showTypingCursor(lastCharRect);
					waitingAtParagraphEnd = true;
					window.setTimeout(resume, 1000);
				} else {
					resume();
				}

				return;
			}

			if (skipCurrentParagraph) {
				skipCurrentParagraph = false;

				while (stepIndex < paragraph.length) {
					const skippedStep = paragraph[stepIndex++];

					if (skippedStep.type === 'attach') {
						skippedStep.parent.appendChild(skippedStep.node);
						continue;
					}

					skippedStep.node.appendData(skippedStep.char);
					const offset = skippedStep.node.length - 1;
					const rect = charRect(skippedStep.node, offset);

					if (rect) lastCharRect = rect;
				}

				typeNext();
				return;
			}

			const step = paragraph[stepIndex++];

			if (step.type === 'attach') {
				step.parent.appendChild(step.node);
				window.setTimeout(typeNext, 10);
				return;
			}

			step.node.appendData(step.char);

			const offset = step.node.length - 1;
			const rect = charRect(step.node, offset);

			if (rect) lastCharRect = rect;

			window.setTimeout(typeNext, 10);
		};

		bio.addEventListener('click', (event) => {
			if (event.target instanceof Element && event.target.closest('a')) return;
			if (!bio.classList.contains('is-complete') && !waitingAtParagraphEnd) {
				skipCurrentParagraph = true;
			}
		});

		const start = () => {
			if (reducedMotion) {
				paragraphs.forEach((paragraph) => {
					paragraph.forEach((step) => {
						if (step.type === 'attach') {
							step.parent.appendChild(step.node);
						} else {
							step.node.appendData(step.char);
						}
					});
				});
				complete();
			} else {
				window.setTimeout(typeNext, 180);
			}
		};

		if (document.fonts?.ready) {
			document.fonts.ready.then(start);
		} else {
			start();
		}
	}
</script>
